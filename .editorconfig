# https://editorconfig.org/
# https://github.com/editorconfig/editorconfig/wiki/EditorConfig-Properties

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
max_line_length = 42
trim_trailing_whitespace = true

[*.nix]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
trim_trailing_whitespace = true
insert_final_newline = true


[*.{diff,md}]
trim_trailing_whitespace = false

# [*]
# indent_style = space
# indent_size = tab
# tab_width = 2
#
# [*.nix]
# indent_style = space
# indent_size = tab
# tab_width = 2
# max_line_length = 100
# trim_trailing_whitespace = true
# insert_final_newline = true

