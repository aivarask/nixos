(( $+functions[_fh_commands] )) ||
_fh_commands() {
    local commands; commands=(
'add:Adds a flake input to your flake.nix' \
'apply:Apply the configuration at the specified FlakeHub output reference to the current system' \
'completion:Prints completion for shells to use' \
'convert:Convert flake inputs to FlakeHub when possible' \
'eject:Convert flake inputs from FlakeHub back to GitHub' \
'init:Create a new flake.nix using an opinionated interactive initializer' \
'list:Lists key FlakeHub resources' \
'login:Log in to FlakeHub in order to allow authenticated fetching of flakes' \
'resolve:Resolves a FlakeHub flake reference into a store path' \
'search:Searches FlakeHub for flakes that match your query' \
'status:Check your FlakeHub token status' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'fh commands' commands "$@"
}
(( $+functions[_fh__add_commands] )) ||
_fh__add_commands() {
    local commands; commands=()
    _describe -t commands 'fh add commands' commands "$@"
}
(( $+functions[_fh__apply_commands] )) ||
_fh__apply_commands() {
    local commands; commands=(
'home-manager:Resolve the store path for a Home Manager configuration and run its activation script' \
'nix-darwin:Resolve the store path for a nix-darwin configuration and run its activation script' \
'nixos:Apply the resolved store path on a NixOS system' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'fh apply commands' commands "$@"
}
