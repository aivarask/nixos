{
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/",
      "Fp\\": "fp/"
    },
    "files": [
      "fp/Crawl.php",
      "fp/Dilaina.php",
      "fp/Util.php",
      "fp/twig.php",
      "gt/functions.php"
    ]
  },
  "require": {
    "guzzlehttp/guzzle": "^7.8",
    "spatie/async": "^1.6",
    "symfony/css-selector": "^6.4",
    "symfony/dom-crawler": "^6.4",
    "twig/twig": "^3.14",
    "vlucas/phpdotenv": "^5.6"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  }
}
