{
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "require": {
    "vlucas/phpdotenv": "^5.6",
    "twig/twig": "^3.8",
    "cboden/ratchet": "^0.4.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  }
}
