<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="about:blank" />
    <link href="/_.css" rel="stylesheet" type="text/css" />
    <script src="/js/htmx.js"></script>
    <script src="/js/multi-swap.js"></script>
    <script src="/js/sse.js"></script>
    <script src="/js/dilaina.js"></script>
    <script>
      function linkHandler(event) { event.stopPropagation() }
    </script>
    {% block head %}

    {% endblock %}
  </head>

  <body hx-ext="multi-swap" hx-boost="false">
    <div class="wrapper">
      <div id="top">
        {% include 'search_form.twig' %}
        {% block top %}

        {% endblock %}
      </div>
      <div id="content">
        {% block content %}
          <pre>
            <!-- {{ dump(_context) }} -->
          </pre>
        {% endblock %}
      </div>
      <div id="footer">
        {% block footer %}
          {% if S.SERVER_NAME == 'localhost' %}
            {% include 'greet.twig' %}
            {% include 'mirror.twig' %}
            {% include 'fuser.twig' %}
          {% endif %}
        {% endblock %}
      </div>
    </div>
  </body>
</html>
