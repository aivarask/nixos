#compdef foo

function _foo {

  local -a _descriptions _values

  _descriptions=(
    'foo -- Description of foo'
    'bar -- Description of bar'
    'baz -- Description of baz'
    'zoo -- Description of zoo'
  )

  _values=(
    'bar'
    'foo'
    'baz'
    'zoo'
  )

  compadd -d _descriptions -a _values
}

