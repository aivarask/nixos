# /etc/profiles/per-user/root/share/doc/ncmpcpp/config
mpd_connection_timeout = 1
mpd_music_dir = "/var/music";
connected_message_on_startup = "no";
display_bitrate = "yes";
playlist_show_mpd_host = "yes";
allow_for_physical_item_deletion = "yes";
incremental_seeking = yes
seek_time = 30
search_engine_default_search_mode = 1
external_editor = nvim
use_console_editor = yes

user_interface = "alternative";
alternative_header_first_line_format = "$b$5 {%a}|{%t} $9$/b";
alternative_header_second_line_format = "$b$5 {%b}|{%f} {%b} ({%y})$9$/b";
song_columns_list_format = "(20)[blue]{a|f} (20)[green]{bE} (40)[yellow]{tE} (10)[red]{y}";

