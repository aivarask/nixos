# /etc/profiles/per-user/root/share/doc/ncmpcpp/bindings
def_key "j"
	scroll_down

def_key "k"
	scroll_up

def_key "J"
  select_item
  scroll_down

def_key "K"
  select_item
  scroll_up

def_key "alt-j"
	move_selected_items_down

def_key "alt-k"
	move_selected_items_up

