XF86HomePage
	firefox --new-window https://www.youtube.com/
XF86Mail
	firefox --new-window https://www.messenger.com/
XF86Calculator
  alacritty -e ncmpcpp -c $NCMPCPP_CONFIG -b $NCMPCPP_BINDINGS
Print
  scrot
super + ctrl + Return
  tabbed -c alacritty --embed
super + F1
  notify-send "$(vimcat $SXHKDRC)"
super + F2
  alacritty -e htop
super + F3
  alacritty -e ncmpcpp -c $NCMPCPP_CONFIG -b $NCMPCPP_BINDINGS
super + F4
  alacritty -e pulsemixer
super + F5
  kill -SIGUSR1 $(pidof sxhkd) && dunstify 'sxhkd reloaded' && pkill -USR1 hx
super + F6
  alacritty -e tremc
super + F7
	alacritty -e sysz
super + F8
	printenv
{q,w,e,r} + super
  {tdrop alacritty\
  ,$BROWSER\
  ,alacritty --working-directory=/etc/nixos -e nvr\
  ,alacritty --working-directory=/etc/nixos -e ''
  }
{a,s} + super
  pulsemixer --change-volume {-,+}2 --max-volume 100
{z,x,c,v} + super
	{brightnessctl set 10%-\
	,brightnessctl set 10%+\
	,alacritty --working-directory=/root -e nvim\
	,alacritty -e pulsemixer
	}
{W,E,R,T,Y} + super
  {firefox --private-window\
  ,alacritty --working-directory=/etc/nixos -e vim\
  ,alacritty --working-directory=/etc/nixos\
	,telegram-desktop\
	,brave youtube.com\
  }
{A,S} + super
	ssh pcw -t 'pulsemixer --change-volume {-,+}2 --max-volume 100'

# DISPLAY=:0 xdotool getactivewindow key "Super+F1"
# https://www.reddit.com/r/archlinux/comments/slf7f4/xdotool_key_wont_work_with_sxhkd/
ctrl + super + p ; {n,p,F1}
	{tdrop alacritty -e ssh pcw -t 'ncmpcpp_'\
	,tdrop alacritty -e ssh pcw -t 'pulsemixer'\
	,ssh pcw -t 'DISPLAY=:0 xdotool getactivewindow key Super+F1'
	}

XF86Audio{Play,Mute,Prev,Next}
  mpc {play,stop,prev,next}
XF86Audio{Lower,Raise}Volume
  pulsemixer --change-volume {-,+}2 --max-volume 100
XF86MonBrightness{Down,Up}
  brightnessctl set 10%{-,+}
