# vim:ft=conf
# :read $shell %shell-pipe !shell-wait &shell-async
# f fs fx
$mkdir -p ~/.trash
set previewer pistol
map t

map E $nvr $fx
map gn $lf -remote "send $id cd /etc/nixos"
map gd $lf -remote "send $id cd ~/Downloads"
map gtw $lf -remote "send $id cd /var/lib/transmission/watch-dir"
map gtd $lf -remote "send $id cd /var/lib/transmission/Downloads"
map gx &xdg-open $fx
map og &gimp $fx
map of &firefox $fx
map oz &zathura $fx
map Yc $cat $f | xclip -selection clipboard
map \\l $lazygit

cmd quit-and-cd &{{
    pwd > "$LF_CD_FILE"
    lf -remote "send $id quit"
}}

map Q quit-and-cd
