<form id="dilaina_form"
  hx-get="/dilaina/"
  hx-target="#dilaina_dialog"
  hx-swap="multi:#dilaina_form,#dilaina_dialog:outerHTML">
  <input id="fraze"
    name="fraze"
    onclick="remove(event)"
    size="30"
    value="{{ fraze }}"
    placeholder="Dilaina search" />
  <button type="button" onclick="emptyLast(event)" title="Clear Last">
    &#9668;
  </button>
  <button type="button" onclick="empty(event)" title="Clear">&#10006;</button>
  <button type="submit" id="dilaina_submit" title="Submit">&#x2714;</button>
</form>
<dialog id="dilaina_dialog" {% if open %}open{% endif %}>
  <button id="dilaina_close" autofocus onclick="close()">Close</button>
  {% set base = 'https://www.dilaina.lt' %}
  {% for item in ditems %}
    <div>
      <a href="{{ base }}{{ item.href }}" target="_blank">
        {{ item.price }} {{ item.name }}
      </a>
    </div>
  {% else %}
    Nothing found
  {% endfor %}

  <script type="text/javascript">
    var dialog = document.getElementById('dilaina_dialog'); var close =
    document.getElementById('dilaina_close'); close.addEventListener("click",
    function() { dialog.close();});
  </script>
</dialog>
