{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "/etc/nixos/vim/schemas/sqlint.json",
  "title": "sqlintrc",
  "description": "Sqlintrc schema",
  "type": "object",
  "properties": {
    "rules": {
      "type": "object",
      "description": "Rules object",
      "properties": {
        "align-column-to-the-first": {
          "$ref": "#err",
          "default": "error",
          "description": "Aligns to the first"
        },
        "column-new-line": {
          "$ref": "#err",
          "default": "error",
          "description": "Column new line"
        },
        "linebreak-after-clause-keyword": {
          "$ref": "#err",
          "default": "error",
          "description": "Line break after clause keyword"
        },
        "reserved-word-case": {
          "description": "Reserver word case",
          "type": "array",
          "items": [
            {
              "$ref": "#err",
              "default": "error"
            },
            {
              "$ref": "#case",
              "default": "upper"
            }
          ]
        },
        "space-surrounding-operators": {
          "$ref": "#err",
          "default": "error",
          "description": "Space surrounding operators"
        },
        "where-clause-new-line": {
          "$ref": "#err",
          "default": "error",
          "description": "Where clause new line"
        },
        "align-where-clause-to-the-first": {
          "$ref": "#err",
          "default": "error",
          "description": "Align where clause to the first"
        }
      }
    }
  },
  "definitions": {
    "err": {
      "$id": "#err",
      "type": "string",
      "enum": [
        "error",
        "warn",
        "off"
      ]
    },
    "case": {
      "$id": "#case",
      "type": "string",
      "default": "upper",
      "enum": [
        "upper",
        "lower"
      ]
    }
  }
}
