{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "/etc/nixos/schemas/sqllsrc.json",
  "title": "sqllsrc",
  "description": "sqllsrc config",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Connection name"
    },
    "adapter": {
      "type": "string",
      "description": "Connection adapter",
      "enum": [
        "mysql",
        "postgres",
        "sqlite3",
        "bigquery"
      ]
    },
    "host": {
      "type": "string"
    },
    "port": {
      "description": "mysql:3306, postgres:5432",
      "type": "string"
    },
    "user": {
      "type": "string"
    },
    "password": {
      "type": "string"
    },
    "database": {
      "type": "string"
    },
    "filename": {
      "type": "string",
      "description": "Database filename (only for sqlite)"
    },
    "projectPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
