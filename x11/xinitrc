#!/bin/sh

export XCURSOR_THEME=XCursor-Pro-Light
export XCURSOR_SIZE=64
xrdb ~/.Xresources

# export GDK_SCALE="2"
# export GTK2_RC_FILES=/etc/nixos/x11/gtk2/gtkrc
# export QT_QPA_PLATFORMTHEME=gtk2
# export QT_STYLE_OVERRIDE=kvantum
export GDK_DPI_SCALE="0.75"
export GTK_THEME=Adwaita:dark
export NVIM_REMOTE=~/.cache/nvim/server.pipe
export EDITOR="nvim --server $NVIM_REMOTE"

# https://nixos.org/manual/nixos/stable/#sec-x11
systemctl --user import-environment DISPLAY XDG_SESSION_ID           # import required env variables from the current shell
systemctl --user start nixos-fake-graphical-session.target           # start all graphical user services
dbus-daemon --session --address="unix:path=/run/user/$(id -u)/bus" & # start the user dbus daemon

# xcompmgr &
# picom -b &
# xrandr_dpi
xrdb ~/.Xresources
#
devilspie2 -a
numlockx
xset r rate 250 50
sxhkd &

if [ "$(hostname)" = pc ]; then
	xset s 3600 3600
	# xset dpms3600 3600 3600
	nvidia-settings -a '[gpu:0]/GPUFanControlState=1' -a '[fan:0]/GPUTargetFanSpeed=40' --load-config-only
	# XDG_SESSION_TYPE=x11 remote-touchpad -bind :9000 -secret pc &
	# deskflow-client -f --debug INFO --name pc --enable-crypto --sync-language dell:24800 &
elif [ "$(hostname)" = dell ]; then
	# deskflow-server -f --debug INFO --name dell --enable-crypto --address :24800 -c /etc/nixos/deskflow-dell/deskflow-server.conf --tls-cert /etc/nixos/deskflow-dell/tls/deskflow.pem &
	systemctl --user restart redshift.service &
fi

systemctl --user restart dunst.service &
systemctl --user restart wallpaper.service &
systemctl --user restart unclutter-xfixes.service &
systemctl --user restart dwm-status.service &

session=${1:-dwm}
case $session in
dwm)
	exec dwm
	;;
*)
	exec "$1"
	;;
esac
