{
	"custom/icon1": {
		"format": "{}  ",
		"tooltip": false,
		"on-click": "spotify",
		"on-click-right": "kitty -e ncmpcpp"
	},
	"custom/icon2": {
		"format": "{} 󰉋 ",
		"tooltip": false,
		"on-click": "nautilus",
		"on-click-right": "kitty -e ranger"
	},
	"custom/icon3": {
		"format": "{} 󰨇 ",
		"tooltip": false,
		"on-click": "gnome-system-monitor",
		"on-click-right": "kitty -e bashtop"
	},
	"modules-center": [
		"custom/music"
		// "sway/window",
		// "systemd-failed-units",
		// "sway/scratchpad",
		// "mpris",
		// "tray",
		// "temperature",
	],
	"sway/scratchpad": {
		"format": "{icon} {count}",
		"show-empty": false,
		"tooltip": true,
		"tooltip-format": "{app}: {title}"
	},
	"tray": {
		"spacing": 10,
		"icons": {
			"blueman": "bluetooth",
			"TelegramDesktop": "/run/current-system/sw/share/icons/Papirus/16x16/apps/telegram.svg",
		},
	},
	"temperature": {
		"hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
		"critical-threshold": 80,
		"format": "{temperatureC}°C {icon}",
	},
	"systemd-failed-units": {
		"hide-on-ok": true,
		"format": "✗ {nr_failed}:{nr_failed_user}",
		"format-ok": "✓",
		"system": true,
		"user": true,
		"on-click": ""
	},
}
