// -*- mode: jsonc -*-
// vim: iskeyword+=-
[
	// {
	// 	"name": "bottom_bar",
	// 	"position": "bottom",
	// 	"height": 32,
	// 	"spacing": 8,
	// 	"layer": "top",
	// 	"exclusive": true,
	// 	// "passthrough": true,
	// 	"start_hidden": false,
	// 	// "ipc": true,
	// 	"include": [
	// 		"./custom.jsonc"
	// 	],
	// 	"modules-left": [],
	// 	"modules-right": [
	// 		"pulseaudio",
	// 		"mpris"
	// 	]
	// },
	{
		"name": "top_bar",
		"layer": "top",
		"position": "top",
		"height": 32,
		"spacing": 12,
		"ipc": true,
		"reload_style_on_change": true,
		"include": [
			"./custom.jsonc"
		],
		"modules-left": [
			"tray"
		],
		"modules-center": [
			"custom/drawer",
			"niri/workspaces",
			"wlr/taskbar"
		],
		"modules-right": [
			// "idle_inhibitor",
			"pulseaudio/slider",
			"pulseaudio",
			// "custom/brightness",
			"battery",
			"backlight",
			"network",
			"niri/language",
			"custom/wttrbar",
			"clock",
			"custom/power"
		],
		"tray": {
			// waybar-tray
			"show-passive-items": true,
			"icon-size": 16,
			"spacing": 8
		},
		"battery": {
			// waybar-battery
			"bat": "BAT0",
			"format": "{icon}  {capacity}",
			"format-alt": "{icon}  {time}",
			"format-time": "{H}h{M}m",
			"format-full": "{capacity}",
			"format-charging": "{icon}  ⚡{capacity}",
			"format-plugged": "{icon}  🔌{capacity}",
			// "format-icons": [
			// "",
			// "",
			// "",
			// "",
			// ""
			// ]
		},
		"backlight": {
			// waybar-backlight
			"format": "🔅{percent}",
			"smooth-scrolling-threshold": 3.0,
			"reverse-scrolling": true,
			"scroll-step": 5.0,
			"min-brightness": 5.0
		},
		"network": {
			// waybar-network
			"format-ethernet": "🌐",
			"tooltip-format-ethernet": "{ipaddr} {ifname}",
			"format-wifi": "  {essid}",
			"tooltip-format-wifi": "{signalStrength} {signaldBm} \n {ipaddr} {ifname} \n left reconnect \n middle disconnect \n right 192.168.0.1",
			"format-disconnected": " ",
			"tooltip-format-disconnected": "click to connect",
			"on-click": "iwctl station wlan0 connect zte",
			"on-click-middle": "iwctl station wlan0 disconnect",
			"on-click-right": "iwctl station wlan0 disconnect"
			// "on-click-right": "xdg-open http://192.168.0.1"
		},
		"pulseaudio/slider": {
			"min": 0,
			"max": 100,
			"orientation": "horizontal"
		},
		"niri/language": {
			"format-en": "🇺🇸",
			"format-lt": "🇱🇹",
			"on-click": "niri msg action switch-layout next"
		},
		"clock": {
			"format": "{:%A %B %d %H:%M %p}",
			"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
		},
		"custom/drawer": {
			"format": " {}",
			"on-click": "nwg-drawer",
			"tooltip": false
		},
		"niri/workspaces": {
			// waybar-niri-workspaces
			"all-outputs": true,
			"hide-empty": true,
			"format": "{icon}  {output}/{value}",
			"format-icons": {
				"active": "",
				"default": ""
			}
		},
		"wlr/taskbar": {
			// waybar-wlr-taskbar
			"format": "{icon} {short_state} {app_id}",
			"icon-size": 16,
			"spacing": 4,
			"tooltip-format": "{title}",
			"ignore-list": [],
			"on-click": "activate",
			"on-click-right": "fullscreen",
			"on-dblclick": "maximize",
			"on-click-middle": "close"
		},
		"custom/wttrbar": {
			"format": "{}° ",
			"return-type": "json",
			"exec": "wttrbar --location Sirvintos",
			"tooltip": true,
			"interval": 3600
		},
		"custom/power": {
			"format": " ⏻ ",
			"tooltip": false,
			"menu": "on-click",
			"menu-file": "$HOME/.config/waybar/power.xml",
			"menu-actions": {
				"suspend": "systemctl suspend",
				// "hibernate": "systemctl hibernate",
				"reboot": "systemctl reboot",
				"poweroff": "systemctl poweroff"
			}
		},
		"custom/brightness": {
			// waybar-custom
			"exec": "brightness_monitor",
			"format": "🔅 {text}",
			"return-type": "json",
			"restart-interval": 2,
			"tooltip": false,
			"on-scroll-up": "ddcutil setvcp 10 + 5",
			"on-scroll-down": "ddcutil setvcp 10 - 5",
			"on-click": "ddcutil setvcp 10 20",
			"on-click-right": "ddcutil setvcp 10 90"
		}
	}
]
