// -*- mode: jsonc -*-
[
	{
		"name": "bottom_bar",
		"position": "bottom",
		"height": 32,
		"spacing": 8,
		"layer": "top",
		"exclusive": true,
		// "passthrough": true,
		"start_hidden": false,
		// "ipc": true,
		"include": [
			"./custom.jsonc"
		],
		"modules-left": [],
		"modules-right": [
			"pulseaudio",
			"mpris"
		]
	},
	{
		"name": "top_bar",
		"layer": "top",
		"position": "top",
		"height": 32,
		"spacing": 18,
		"ipc": true,
		"reload_style_on_change": true,
		"include": [
			"./custom.jsonc"
		],
		"modules-left": [
			"tray"
		],
		"modules-center": [
			"custom/drawer",
			"wlr/taskbar"
		],
		"modules-right": [
			// "idle_inhibitor",
			"pulseaudio",
			// "custom/brightness",
			"battery",
			"backlight",
			"network",
			"niri/language",
			"custom/wttrbar",
			"clock",
			"custom/power"
		],
		"tray": {
			// waybar-tray
			"show-passive-items": true,
			"icon-size": 16,
			"spacing": 8
		},
		"battery": {
			// waybar-battery
			"format": "{icon} {capacity}",
			"format-alt": "{icon} {time}",
			"format-time": "{H}h{M}m",
			"format-full": "{icon} {capacity}",
			"format-charging": "{icon} ⚡{capacity}",
			"format-plugged": "{icon} 🔌{capacity}",
			"format-icons": [
				"",
				"",
				"",
				"",
				""
			]
		},
		"backlight": {
			// waybar-backlight
			"format": "🔅{percent}",
			"smooth-scrolling-threshold": 3.0,
			"reverse-scrolling": true,
			"scroll-step": 5.0,
			"min-brightness": 5.0
		},
		"network": {
			// waybar-network
			"format-ethernet": "🌐",
			"tooltip-format-ethernet": "{ipaddr} {ifname}",
			"format-wifi": "  {essid} {signalStrength} {signaldBm}",
			"tooltip-format-wifi": "{ipaddr} {ifname} \n left reconnect \n middle disconnect \n right 192.168.0.1",
			"format-disconnected": " ",
			"tooltip-format-disconnected": "click to connect",
			"on-click": "iwctl station wlan0 connect zte",
			"on-click-middle": "iwctl station wlan0 disconnect",
			"on-click-right": "iwctl station wlan0 disconnect"
			// "on-click-right": "xdg-open http://192.168.0.1"
		},
		"niri/language": {
			"format-en": "🇺🇸",
			"format-lt": "🇱🇹",
			"on-click": "niri msg action switch-layout next"
		},
		"clock": {
			"format": "{:%A %B %d %H:%M %p}",
			"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
		},
		"idle_inhibitor": {
			"format": "{icon} ",
			"format-icons": {
				"activated": "",
				"deactivated": ""
			},
			"timeout": 30.5
		},
		"custom/drawer": {
			"format": " {}",
			"on-click": "nwg-drawer",
			"on-click-right": "nwg-menu",
			"tooltip": false,
			"tooltip-format": "nwg-drawer"
		},
		"custom/brightness": {
			// waybar-custom
			"exec": "brightness_monitor",
			"format": "🔅 {text}",
			"return-type": "json",
			"restart-interval": 2,
			"tooltip": false,
			"on-scroll-up": "ddcutil setvcp 10 + 5",
			"on-scroll-down": "ddcutil setvcp 10 - 5",
			"on-click": "ddcutil setvcp 10 20",
			"on-click-right": "ddcutil setvcp 10 90"
		},
		"custom/wttrbar": {
			"format": "{}° ",
			"return-type": "json",
			"exec": "wttrbar --location Sirvintos",
			"tooltip": true,
			"interval": 3600
		},
		"custom/power": {
			"format": " ⏻ ",
			"tooltip": false,
			"menu": "on-click",
			"menu-file": "$HOME/.config/waybar/power.xml",
			"menu-actions": {
				"suspend": "systemctl suspend",
				// "hibernate": "systemctl hibernate",
				"reboot": "systemctl reboot",
				"poweroff": "systemctl poweroff"
			}
		},
		"wlr/taskbar": {
			// waybar-wlr-taskbar
			"format": "{icon}",
			"icon-size": 16,
			"spacing": 4,
			"on-click-middle": "close",
			"tooltip-format": "{title}",
			"ignore-list": [],
			"on-click": "activate"
		}
	}
]
