// -*- mode: jsonc -*-
{
	"layer": "bottom",
	"spacing": 0,
	"reload_style_on_change": true,
	"include": [
		"~/.config/waybar/audio.jsonc",
		"~/.config/waybar/modules.jsonc",
		"~/.config/waybar/network.jsonc"
	],
	"modules-left": [
		"sway/workspaces",
		"sway/mode"
	],
	"modules-center": [
		"sway/scratchpad"
		// "sway/window"
	],
	"custom/foo": {
		// https://github.com/Alexays/Waybar/wiki/Module:-Custom
		"exec": "brightness_monitor",
		"format": "{text}%",
		"return-type": "json",
		// "exec-on-event": true,
		"restart-interval": 2,
		"tooltip": false,
		"on-scroll-up": "ddcutil setvcp 10 + 5",
		"on-scroll-down": "ddcutil setvcp 10 - 5",
		"on-click": "ddcutil setvcp 10 20",
		"on-click-right": "ddcutil setvcp 10 90"
	},
	"systemd-failed-units": {
		"hide-on-ok": false, // Do not hide if there is zero failed units.
		"format": "✗ {nr_failed}",
		"format-ok": "✓",
		"system": true, // Monitor failed systemwide units.
		"user": true // Ignore failed user units.
	},
	"modules-right": [
		"systemd-failed-units",
		"custom/foo",
		"custom/weather",
		"pulseaudio",
		"network",
		"backlight",
		"battery",
		"sway/language",
		"clock"
	],
	// Modules configuration
	"sway/workspaces": {
		"disable-scroll": false,
		"all-outputs": true,
		"warp-on-scroll": false,
		"format": "{name}: {icon}",
		"format-icons": {
			"1": "",
			"2": "",
			"3": "",
			"4": "",
			"urgent": "",
			"focused": "",
			"default": ""
		}
	},
	"sway/mode": {
		"format": "<span>{}</span>"
	},
	"sway/scratchpad": {
		"format": "{icon} {count}",
		"show-empty": false,
		"format-icons": [
			"",
			""
		],
		"tooltip": true,
		"tooltip-format": "{app}: {title}"
	}
}
