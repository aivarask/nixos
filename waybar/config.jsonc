// -*- mode: jsonc -*-
{
	"layer": "bottom",
	"spacing": 0,
	"reload_style_on_change": true,
	"include": [
		"~/.config/waybar/audio.jsonc",
		"~/.config/waybar/_left.jsonc",
		"~/.config/waybar/_center.jsonc",
	],
	"modules-right": [
		"mpris",
		// "custom/weather",
		"pulseaudio",
		"custom/brightness",
		"backlight",
		"network",
		"battery",
		"sway/language",
		"clock"
	],
	"mpris": {
		"format": "{player_icon} {dynamic}",
		"format-paused": "{status_icon} {dynamic}",
		"player-icons": {
			"default": "▶",
			"spotify": "S",
			"mpv": "🎵"
		}
	},
	"custom/weather": {
		"format": "{}° ",
		"return-type": "json",
		"exec": "wttrbar --location Sirvintos",
		"tooltip": true,
		"interval": 3600,
	},
	"custom/brightness": {
		// waybar-custom https://github.com/Alexays/Waybar/wiki/Module:-Custom
		"exec": "brightness_monitor",
		"format": "😎 {text}",
		"return-type": "json",
		"restart-interval": 2,
		"tooltip": false,
		"on-scroll-up": "ddcutil setvcp 10 + 5",
		"on-scroll-down": "ddcutil setvcp 10 - 5",
		"on-click": "ddcutil setvcp 10 20",
		"on-click-right": "ddcutil setvcp 10 90"
	},
	"backlight": {
		"format": "😎 {percent}",
		"smooth-scrolling-threshold": 3.0,
		"scroll-step": 5.0,
		"min-brightness": 5.0,
	},
	"network": {
		"format-wifi": " {essid} {signalStrength}",
		"format-ethernet": "{ipaddr}/{cidr} ",
		"format-alt": "{ipaddr}/{cidr} {ifname}",
		"tooltip-format": "{gwaddr} {ifname}",
		"format-linked": "{ifname} (No IP)",
		"format-disconnected": "No internet",
		"on-click-right": "xdg-open https://192.168.1.1"
	},
	"battery": {
		"states": {
			"critical": 20,
			"warning": 40,
			"good": 80,
		},
		"format": "{icon}  {capacity}",
		"format-alt": "{icon}  {time}",
		"format-time": "{H}h{M}m",
		"format-full": "{icon}  {capacity}",
		"format-charging": " {capacity}",
		"format-plugged": " {capacity}",
		"format-icons": [
			"",
			"",
			"",
			"",
			""
		]
	},
	"sway/language": {
		"format": "{flag}"
	},
	"clock": {
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
		"format": "{:%T}",
		"format-alt": "{:%Y-%m-%d}",
		"interval": 1
	},
	"custom/power": {
		"format": " ⏻ ",
		"tooltip": true,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml",
		"menu-actions": {
			"shutdown": "shutdown"
		}
	},
}
