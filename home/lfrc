# vim:ft=conf

# read           (modal)   (default ':')
# shell          (modal)   (default '$')
# shell-pipe     (modal)   (default '%')
# shell-wait     (modal)   (default '!')
# shell-async    (modal)   (default '&')
# f 	Current file.
# fs 	Selected with filesep
# fx 	Selected or current.

map gn $lf -remote "send $id cd /etc/nixos"
map gx &xdg-open $fx
map og &gimp $fx
map of &firefox $fx
map ol $lazygit
map oz &zathura $fx
map on &notify-send 'zoo'
map Yc !cat $f | xclip -selection clipboard
map \\lg $lazygit
