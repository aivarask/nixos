{
  "pre-json-stringify": {
    "prefix": [
      "pre"
    ],
    "body": [
      "<pre>{JSON.stringify(${1} , null, 2)}</pre>"
    ]
  },
  "script": {
    "prefix": [
      "script"
    ],
    "body": [
      "<script>",
      "\t${0}",
      "</script>"
    ]
  },
  "$props": {
    "prefix": [
      "ldp"
    ],
    "body": [
      "let { ${1} } = \\$props()"
    ],
    "description": ""
  },
  "form": {
    "prefix": [
      "form",
      "s-form"
    ],
    "body": [
      "<form method=\"post\" action=\"${1}\" ${use:enhace:2}>",
      "\t${0}",
      "</form>"
    ]
  }
}
