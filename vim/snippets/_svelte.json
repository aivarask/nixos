{
  "pre-json-stringify": {
    "prefix": [
      "pre"
    ],
    "body": [
      "<pre>{JSON.stringify(${1} , null, 2)}</pre>"
    ]
  },
  "script": {
    "prefix": [
      "script"
    ],
    "body": [
      "<script>",
      "\t${0}",
      "</script>"
    ]
  },
  "$props": {
    "prefix": [
      "ldp"
    ],
    "body": [
      "let { ${1} } = \\$props()"
    ],
    "description": ""
  },
  "form": {
    "prefix": [
      "form",
      "s-form"
    ],
    "body": [
      "<form method=\"post\" action=\"${1}\" ${2:use:enhance}${3}>",
      "\t${0}",
      "</form>"
    ]
  },
  "input": {
    "prefix": [
      "input",
      "s-input"
    ],
    "body": [
      "<input name=\"${1}\" placeholder=\"${1}\" ${0}/>"
    ]
  },
  "button": {
    "prefix": [
      "button-submit"
    ],
    "body": [
      "<button type=\"submit\">${1:Submit}</button>"
    ]
  },
  "input-submit": {
    "prefix": [
      "input-submit"
    ],
    "body": [
      "<input type=\"submit\" value=\"${1:submit}\" />"
    ]
  }
}
