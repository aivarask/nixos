{
  "nixosModule": {
    "prefix": [
      "nixosModule"
    ],
    "body": [
      "{ ${1:pkgs,} ... }: {${0}}"
    ]
  },
  "environment.systemPackages": {
    "prefix": [
      "environment.systemPackages"
    ],
    "body": [
      "environment.systemPackages = with pkgs; [ ${0} ]; "
    ]
  }
}
