[alias]
        ci = "commit"
        pr = "pull --rebase"

[core]
        hookspath = ".githooks"

[credential "https://gist.github.com"]
        helper = "/nix/store/a42dil5xrgf74ir5nnryhyg4v0ymkpi0-gh-2.69.0/bin/gh auth git-credential"

[credential "https://github.com"]
        helper = "/nix/store/a42dil5xrgf74ir5nnryhyg4v0ymkpi0-gh-2.69.0/bin/gh auth git-credential"

[filter "lfs"]
        clean = "git-lfs clean -- %f"
        process = "git-lfs filter-process"
        required = true
        smudge = "git-lfs smudge -- %f"

[gpg]
        format = "openpgp"

[gpg "openpgp"]
        program = "/nix/store/pggww1d2pg24fcg5v36xn63n53vanyyi-gnupg-2.4.7/bin/gpg"

[init]
        defaultBranch = "main"

[pull]
        rebase = true

[user]
        email = "kalesnykas.aivaras@gmail.com"
        name = "Aivaras Kalesnykas"
