#!/usr/bin/env zsh
# shellcheck shell=zsh
export ZVM_OPEN_FILE_CMD="$VISUAL"
export ZVM_OPEN_URL_CMD="$BROWSER"

function zvm_config() {
  ZVM_LINE_INIT_MODE=$ZVM_MODE_INSERT
  ZVM_VI_INSERT_ESCAPE_BINDKEY=jk
}

key[Control-Left]="${terminfo[kLFT5]}"
key[Control-Right]="${terminfo[kRIT5]}"
[[ -n "${key[Control-Left]}"  ]] && bindkey -- "${key[Control-Left]}"  backward-word
[[ -n "${key[Control-Right]}" ]] && bindkey -- "${key[Control-Right]}" forward-word

set zle_bracketed_paste
autoload -Uz bracketed-paste-magic url-quote-magic
zle -N bracketed-paste bracketed-paste-magic
zle -N self-insert url-quote-magic

(( ${+aliases[run-help]} )) && unalias run-help
autoload run-help run-help-git run-help-nix run-help-ip run-help-openssl run-help-sudo
alias help=run-help
bindkey "^[OP" "run-help"            # <F1>
bindkey -s "^[[15~" "exec zsh\n" 		 # <F5>
autoload -Uz history-beginning-search-menu
zle -N history-beginning-search-menu
bindkey '^X^X' history-beginning-search-menu

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

cmd_preview () { echo $BUFFER }
zle -N cmd_preview cmd_preview
bindkey -v '^]' cmd_preview

_quote_word() {
    # Get words array
    local words=(${(z)LBUFFER})
    local last_word="${words[-1]}"

    if [[ -n "$last_word" ]]; then
        # Remove last word from LBUFFER
        LBUFFER="${LBUFFER%$last_word}"
        # Add it back quoted
        LBUFFER+="\"${last_word}\""
    fi
}
zle -N _quote_word
bindkey '^[q' _quote_word  # Alt+Q

psgrep() { pgrep "$@" | xargs --no-run-if-empty ps -f -p; }

preexec() {
# #   print -Pn "\e]0;$0 $@\a"
# 	echo 'foo'
	# echo $TERM
}

nix-clean() {
	nix-env --delete-generations old
	nix-store --gc
	nix-env -u --always
	for link in /nix/var/nix/gcroots/auto/*; do
		rm $(readlink "$link")
	done
    nix-store --verify --check-contents --repair
	nix-collect-garbage -d
}
