# vim:ft=conf
# :read $shell %shell-pipe !shell-wait &shell-async
# f fs fx
# set hidden!
set icons
set ifs "\n"
set info "size"
set ratios "1:2"
set scrolloff 8
set shell "zsh"
set shellopts "-ey"
set previewer pistol_
set cleaner cleaner
#
$mkdir -p ~/.trash
map t

map ++ set ratios 1:2:3
map +w $chmod +w $fx
map +x $chmod +x $fx
map -- set ratios 1:2
map -w $chmod -w $fx
map -x $chmod -x $fx
map . set hidden!
map <c-f> $fzf
map <c-g> $Rg
map <esc> :quit
map \\l $lazygit
map \\m %{{ xdg-mime query filetype "$f" }}
map A push :mkdir<space>
map a push :touch<space>
map D %trash-put $fx
map E $EDITOR $fx
map gd $lf -remote "send $id cd ~/Downloads"
map gn $lf -remote "send $id cd /etc/nixos"
map gtd $lf -remote "send $id cd /var/lib/transmission/Downloads"
map gtw $lf -remote "send $id cd /var/lib/transmission/watch-dir"
map gx &xdg-open $fx
map od &display $f
map of &firefox $fx
map og &gimp $fx
map ox &xdg-open $fx
map oz &zathura $fx
map U !du -hs $fx
map Yc $cat $f | xclip -selection clipboard
map <enter> &xdg-open $fx

