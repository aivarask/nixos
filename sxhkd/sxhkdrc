super + {z,x,c,v}
 {\
 ,brightnessctl set 10%-\
 ,brightnessctl set 10%+\
 ,alacritty --working-directory=/nix/store\
 ,alacritty --working-directory=/nix/store\
 }

super + {A,S}
 ssh pcw -t 'wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 2%{-,+}'
