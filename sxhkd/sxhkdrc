super + ctrl + Return
 tabbed -c alacritty --embed

super + {F1,F2,F3,F4,F5,F6,F7,F8,F9,F10,F11,F12}
 {\
 ,alacritty -T man-fzf -e man-fzf\
 ,hmon\
 ,alacritty -e ncmpcpp\
 ,alacritty -e pulsemixer\
 ,kill -SIGUSR1 $(pidof sxhkd) && systemctl --user restart dwm-status.service && dunstify $(date +"%T")\
 ,pwvucontrol\
 ,notify-send "$(vimcat /root/.config/sxhkd/sxhkdrc)"\
 ,(cd /var/p && mpv --input-ipc-server=/tmp/mpvsocket --log-file=/tmp/mpvlog ./*) \
 ,wezterm\
 ,alacritty -e sh\
 ,alacritty -e bash\
 ,alacritty -e zsh\
 }

super + {q,w,e,r}
 {\
 ,tdrop alacritty\
 ,firefox\
 ,chrome\
 ,alacritty --working-directory=/etc/nixos -e nvim --listen $NVIM_REMOTE \
 }
