super + r; {1,2,n,p,F1}
 {\
 ,alacritty -e ssh -t pcw 'cd /etc/nixos ; exec $SHELL'\
 ,alacritty -e ssh -t pcw 'cd /etc/nixos ; $SHELL -c lazygit'\
 ,tdrop alacritty -e ssh pcw -t 'ncmpcpp'\
 ,ssh pcw -t 'DISPLAY=:0 xdotool key Super+F1'\
 }

super + o; {1,2,3,4,5,6,7,8,9,0}
 {\
 ,alacritty -e sh
 ,notify-send "echo $SHELL"\
 ,notify-send "echo two"\
 ,inkscape '/etc/nixos/a/img/logo.svg'
 }

