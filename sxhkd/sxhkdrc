XF86AudioMute
	wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
XF86Audio{Lower,Raise}Volume
	wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%{-,+}
XF86Audio{Play,Prev,Next}
	mpc {toggle,prev,next}
XF86MonBrightness{Down,Up}
	brightnessctl set 10%{-,+}

super+ ctrl+ Return
	tabbed -c alacritty --embed

super+ Escape
	pkill -USR1 -x sxhkd && notify-send "sxhkd reloaded $(date +"%T")"; \ 
	systemctl --user restart dwm-status.service && notify-send "dwm-status reloaded"

super+ {F1,F2,F3,F4,F5,F6,F7,F8,F9,F10,F11,F12}
	{\
	,alacritty -T man-fzf -e man-fzf \
	,_ \
	,alacritty -e ncmpcpp \
	,alacritty -e pulsemixer \
	,pavucontrol \ 
	,pwvucontrol \ 
	,lmms --allowroot \
	,notify-send "$(vimcat /root/.config/sxhkd/sxhkdrc)" \
	,(cd /var/p && mpv --input-ipc-server=/tmp/mpvsocket --log-file=/tmp/mpvlog ./*) \
	 }

