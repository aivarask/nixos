// vim: sw=4 vartabstop=8,24,60 invlist iskeyword+=- foldmarker=//\ -,};
// https://niri-wm.github.io/niri/Configuration:-Key-Bindings

binds {
    // -X86
    XF86AudioLowerVolume	allow-when-locked=true	{ spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }
    XF86AudioRaiseVolume	allow-when-locked=true	{ spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0"; }
    XF86AudioMute	allow-when-locked=true	{ spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute	allow-when-locked=true	{ spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86AudioPlay	allow-when-locked=true	{ spawn-sh "playerctl play-pause"; }
    XF86AudioStop	allow-when-locked=true	{ spawn-sh "playerctl stop"; }
    XF86AudioPrev	allow-when-locked=true	{ spawn-sh "playerctl previous"; }
    XF86AudioNext	allow-when-locked=true	{ spawn-sh "playerctl next"; }
    XF86MonBrightnessUp	allow-when-locked=true	{ spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown	allow-when-locked=true	{ spawn "brightnessctl" "--class=backlight" "set" "10%-"; };

    // -Esc
    Mod+Escape	hotkey-overlay-title="toggle-overview"	{ toggle-overview; }
    Mod+F1	hotkey-overlay-title="show-hotkey-overlay"	{ show-hotkey-overlay; }
    Mod+F2	hotkey-overlay-title=""	{ show-hotkey-overlay; }
    Mod+F3	hotkey-overlay-title=""	{ show-hotkey-overlay; }
    Mod+F4	hotkey-overlay-title=""	{ show-hotkey-overlay; }
    Mod+F5	hotkey-overlay-title=""	{ show-hotkey-overlay; }
    Mod+F6	hotkey-overlay-title=""	{ show-hotkey-overlay; }
    Mod+F7	hotkey-overlay-title=""	{ show-hotkey-overlay; }
    Mod+F8	hotkey-overlay-title=""	{ show-hotkey-overlay; }
    Mod+F9	hotkey-overlay-title=""	{ spawn-sh ""; }
    Mod+F10	hotkey-overlay-title="swaylock"	{ spawn "swaylock"; }
    Mod+F11	hotkey-overlay-title="quit"	{ quit skip-confirmation=true; }
    Mod+F12	hotkey-overlay-title="loginctl terminate-user"	{ spawn-sh "loginctl terminate-user ''";}
    Print	hotkey-overlay-title="screenshot"	{ screenshot; }
    Ctrl+Print	hotkey-overlay-title="screenshot-screen"	{ screenshot-screen; }
    Alt+Print	hotkey-overlay-title="screenshot-window"	{ screenshot-window; }
    Mod+Pause	hotkey-overlay-title="power-off-monitors"	{ power-off-monitors; };

    // -Grave
    Mod+Grave	hotkey-overlay-title="quick-access-terminal"	{ spawn "kitten" "quick-access-terminal"; }
    Mod+1	hotkey-overlay-title="focus-workspace 1"	{ focus-workspace 1; }
    Mod+2	hotkey-overlay-title="focus-workspace 2"	{ focus-workspace 2; }
    Mod+3	hotkey-overlay-title="focus-workspace 3"	{ focus-workspace 3; }
    Mod+Shift+1	hotkey-overlay-title="move-workspace 1"	{ move-column-to-workspace 1; }
    Mod+Shift+2	hotkey-overlay-title="move-workspace 2"	{ move-column-to-workspace 2; }
    Mod+Shift+3	hotkey-overlay-title="move-workspace 3"	{ move-column-to-workspace 3; };
    
    // -Tab
    Mod+Q	hotkey-overlay-title="close-window"	{ close-window; }
    Mod+W	hotkey-overlay-title=" firefox --new-window"	{ spawn "firefox" "--new-window"; }
    Mod+Shift+W	hotkey-overlay-title=" firefox --private-window"	{ spawn "firefox" "--private-window" "x.com"; }
    Mod+E	hotkey-overlay-title=" kitty -d /etc/nixos vim"	{ spawn "kitty" "-d" "/etc/nixos" "vim"; }
    Mod+R	hotkey-overlay-title="switch-preset-column-width"	{ switch-preset-column-width; }
    Mod+BracketLeft	hotkey-overlay-title="consume-or-expel-window-left"	{ consume-or-expel-window-left; }
    Mod+BracketRight	hotkey-overlay-title="consume-or-expel-window-right"	{ consume-or-expel-window-right; }
    Mod+Shift+BracketLeft	hotkey-overlay-title="consume-window-into-column"	{ consume-window-into-column; }
    Mod+Shift+BracketRight	hotkey-overlay-title="expel-window-from-column"	{ expel-window-from-column; };

    // -Caps
    Mod+A	hotkey-overlay-title="fuzzel"	{ spawn "fuzzel"; }
    Mod+S	hotkey-overlay-title="fuzzel --placeholder='Search'"	{ spawn "fuzzel"; }
    Mod+D	hotkey-overlay-title="fuzzel"	{ spawn "fuzzel"; }
    Mod+Return	hotkey-overlay-title="kitty"	{ spawn "kitty"; };

    // -Shift
    Mod+Z	hotkey-overlay-title="vol -5"	{ spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-"; }
    Mod+X	hotkey-overlay-title="vol +5"	{ spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0"; }
    Mod+C	hotkey-overlay-title="chromium -incognito"	{ spawn "chromium" "-incognito" "x.com"; }
    Mod+V	hotkey-overlay-title=""	{ spawn "notify-send" ""; }
    Mod+B	hotkey-overlay-title=""	{ spawn "notify-send" ""; }
    Mod+N	hotkey-overlay-title=""	{ spawn "notify-send" ""; }
    Mod+M	hotkey-overlay-title=""	{ spawn "notify-send" ""; }
    Mod+Comma	hotkey-overlay-title=" "	{ spawn "notify-send" ""; }
    Mod+Period	hotkey-overlay-title="-"	{ spawn "notify-send" "period"; }
    Mod+Slash	hotkey-overlay-title=""	{ spawn "notify-send" ""; };

    // -Arrow
    Mod+Right		{ focus-column-right; }
    Mod+Left		{ focus-column-left; }
    Mod+Down		{ focus-window-down; }
    Mod+Up		{ focus-window-up; }
    Mod+Shift+Right		{ move-column-right; }
    Mod+Shift+Left		{ move-column-left; }
    Mod+Shift+Down		{ move-window-down; }
    Mod+Shift+Up		{ move-window-up; };

    // -Mouse
    Mod+WheelScrollDown		{ focus-column-right-or-first; }
    Mod+WheelScrollUp		{ focus-column-left-or-last; };
}
