# vim: ft=bash
export BW_SESSION="cHLrqQeOTy4Z9JYaFBOjviAXbJSDXQ2uZeqgE55CdvYF+LRzIqbhLnmji2Mg6OevppjpXLIOMdTMvMBGUrwisw=="
alias bw_="bitwarden --no-sandbox --session cHLrqQeOTy4Z9JYaFBOjviAXbJSDXQ2uZeqgE55CdvYF+LRzIqbhLnmji2Mg6OevppjpXLIOMdTMvMBGUrwisw=="
alias lg="lazygit"
alias \\l="lazygit"
alias lnav_nvim='lnav $XDG_STATE_HOME/nvim/log $XDG_STATE_HOME/nvim/*.log'
alias oras="curl wttr.in" # https://wttr.in/:help https://github.com/chubin/wttr.in
alias wttr_srv_="wttrbar --location Sirvintos"
alias woo="echo woo"
alias nfu="nix flake update"
alias nrs="nixos-rebuild switch"
alias nr='nrs --option substituters "https://nix-community.cachix.org https://cache.nixos.org https://hyprland.cachix.org"'
alias nr_pc='nrs --option substituters "http://192.168.1.195 https://nix-community.cachix.org https://cache.nixos.org https://hyprland.cachix.org"'
alias s="uwsm start sway-uwsm.desktop"
alias st="speedtest"
alias sway_outputs="swaymsg -t get_outputs"
alias \\s="systemctl-tui -s all"
alias \\t="nix-tree"
alias re="systemctl restart"
alias build_emulate="nix build /etc/nixos\#nixosConfigurations.exampleIso.config.system.build.isoImage && qemu-system-x86_64 -enable-kvm -m 256 -cdrom result/iso/nixos-*.iso"
