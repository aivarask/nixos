# vim: ft=bash

export BW_SESSION="cHLrqQeOTy4Z9JYaFBOjviAXbJSDXQ2uZeqgE55CdvYF+LRzIqbhLnmji2Mg6OevppjpXLIOMdTMvMBGUrwisw=="

alias \\l="lazygit"
alias \\s="systemctl-tui -s all"
alias \\t="nix-tree"
alias bw_="bitwarden --no-sandbox --session $BW_SESSION"
alias lg="lazygit"
alias lnav_nvim='lnav $XDG_STATE_HOME/nvim/log $XDG_STATE_HOME/nvim/*.log'
alias nfu="nix flake update"
alias nrs_="nixos-rebuild switch"
alias nrs="nixos-rebuild switch --no-reexec"
alias nrs_offline="nrs --option substitute false"
alias nr='nrs --option substituters "https://cache.nixos.org https://nix-community.cachix.org"'
alias sway_start="uwsm start sway-uwsm.desktop"
alias st="speedtest"
alias wttr="curl wttr.in" # https://wttr.in/:help https://github.com/chubin/wttr.in
alias wttr_srv="wttrbar --location Sirvintos"
alias celluloid="celluloid --mpv-vo=gpu-next --mpv-gpu-api=vulkan --mpv-hwdec=vulkan --mpv-gpu-context=waylandvk"
alias yt-dlp="yt-dlp --cookies-from-browser firefox"

# alias burn_iso_sdc="dd bs=128K if=$SELF/result/iso/$(ls $SELF/result/iso) of=/dev/sdc oflag=direct status=progress"
alias build_burn_iso_sdc="build_iso && burn_iso_sdc"
alias mount_iso="mount -o loop $SELF/result/iso/nixos-*.iso mnt"
alias build_emulate_iso="build_iso && emulate_iso"
alias build_iso="nix build $SELF\#nixosConfigurations.iso-minimal.config.system.build.isoImage"
alias emulate_iso="qemu-system-x86_64 -enable-kvm -m 1G -cdrom $SELF/result/iso/nixos-*.iso"
