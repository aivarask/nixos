# https://github.com/baskerville/sxhkd
super + F1
  notify-send ' 🚀 Keymaps' "$(cat /etc/nixos/sxhkdrc)"
super + F2
  alacritty -e htop # 🧬
super + F3
  alacritty -e ncmpcpp # ⏯️
super + F4
  alacritty -e pulsemixer # 🔉
super + F5
  kill -SIGUSR1 $(pidof sxhkd) && dunstify ' ⌨️  sxhkd reload OK'
super + F6
  alacritty -e tmux new-session lf \; split-window -h lf \; attach
super + F7
  telegram-desktop
super + F9
  notify-send ' ♻️  nixos-rebuild switch' "$(nixos-rebuild switch)"
super + F10
  dunstctl close

super + {q,w,e,r}
  {tdrop alacritty,\
  $BROWSER,\
  alacritty --working-directory=/etc/nixos -e nvim,\
  alacritty --working-directory=/etc/nixos/siom -e nvim
  }

super + {W,E,R}
  {firefox --private-window,\
  alacritty --working-directory=/etc/nixos,\
  alacritty --working-directory=/etc/nixos/siom\
  }

super + {a,s}
  pulsemixer --change-volume {-,+}2 --max-volume 100

super + {z,x,c,v}
  {brightnessctl set 10%-,brightnessctl set 10%+,alacritty,alacritty -e pulsemixer}

super + ctrl + Return
  tabbed -c alacritty --embed

XF86Audio{Play,Mute,Prev,Next}
  mpc {play,stop,prev,next}
XF86Audio{Lower,Raise}Volume
  pulsemixer --change-volume {-,+}2 --max-volume 100
XF86MonBrightness{Down,Up}
  brightnessctl set 10%{-,+}

Print
  scrot
