-g=!*.svg
-g=!.git/*
-g=!.trash/*
-g=!.local/*
-g=!.BitwigStudio/*
-g=!.cache/*
-g=!**/{vendor}/**
-g=!.{cargo}/*
-g=!.{npm,pnpm}/*
-g=!.{mixxx}/*
-g=!*/{BraveSoftware,chromium,google-chrome-beta,google-chrome-unstable}/*
-g=!.{mozilla,surf}/*
-g=!.{viminfo,bash_history,zsh_history,zcompdump,sqlite_history}

--type-add
web:*.{html,css,js}*

--hidden
--follow
--smart-case
--colors=line:none
--colors=line:style:bold
--max-columns=150
--max-columns-preview

