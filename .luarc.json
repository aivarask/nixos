{
  "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
  "diagnostics.disable": [
    "lowercase-global",
    "missing-fields",
    "unused-local",
    "inject-field",
    "duplicate-set-field"
  ],
  "workspace.checkThirdParty": false,
  "format.enable": false,
  "format.defaultConfig": {
    "indent_style": "space",
    "indent_size": "2",
    "qoute_style": "double",
    "trailing_table_separator": "always",
    "call_arg_parentheses": "remove",
    "insert_final_newline": "true",
    "align_continuous_assign_statement": "true",
    "align_continuous_rect_table_field": "true",
    "align_array_table": "true",
    "line_space_after_comment": "fixed(1)",
    "max_line_length": "200"
  },
  "doc": {
    "EmmyDocCodeStyle": "https://github.com/CppCXY/EmmyLuaCodeStyle/blob/master/docs/format_config_EN.md",
    "lau-language-server": "https://github.com/LuaLS/lua-language-server/wiki/Settings#settings"
  }
}
