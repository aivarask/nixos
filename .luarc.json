{
  "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
  "diagnostics.disable": [
    "lowercase-global",
    "missing-fields",
    "unused-local",
    "inject-field"
  ],
  "workspace.checkThirdParty": false,
  "format": {
    "enable": true,
    "defaultConfig": {
      "indent_style": "space",
      "indent_size": "2",
      "trailing_table_separator": "smart"
    }
  }
}
