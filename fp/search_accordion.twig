<details>
  <summary>
    <div class="title"
      hx-get="/edit?id={{ item.id }}"
      hx-trigger="click[ctrlKey]"
      onclick="append(event)"
      hx-swap="multi:#n{{ item.id }},#t{{ item.id }}">
      <h2 title="{{ item.id }} {{ item.name }}">
        {{ index }}
        {{ item.price }}
        {{ item.name }}
      </h2>
      <a href="{{ item.url }}" target="_blank" onclick="linkHandler(event)">
        View
      </a>
      <a href="{{ item.url_edit }}"
        target="_blank"
        onclick="linkHandler(event)">
        Edit
      </a>
    </div>
    <div id="n{{ item.id }}"></div>
  </summary>
  <div id="t{{ item.id }}" class="info"></div>
</details>
