{% set id = multipart[0]['contents'] %}
<div id="n{{ id }}">
  {% for f in multipart|numbers %}
    <input name="{{ f['name'] }}"
      {{ attributes(f) }}
      value="{{ f['contents'] }}"
      title="{{ f['name'] }} &#10;  {{
      f['contents']
      }} {{ f['contents']|vat }}" />
  {% endfor %}
  <button hx-post="/save/"
    hx-include="#n{{ id }},#t{{ id }}"
    hx-swap="multi:#n{{ id }},#t{{ id }}"
    onclick="linkHandler(event)"
    title="Save">
    &#128190;
  </button>
</div>
<div id="t{{ id }}">
  {% for f in multipart|notnumbers %}
    {% if f['el'] == 'textarea' %}
      <textarea {{ attributes(f) }}
        name="{{ f['name'] }}"
        title="{{ f['name'] }}"
        rows="4">
        {{ f['contents'] }}
      </textarea>
    {% else %}
      <input name="{{ f['name'] }}"
        {{ attributes(f) }}
        {{ isCheckbox(f) }}
        value="{{ f['contents'] }}"
        title="{{ f['name'] }}" />
    {% endif %}
  {% endfor %}
</div>
