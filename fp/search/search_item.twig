<details>
  <summary>
    <div class="title"
      hx-get="/search/?edit_id={{ item.id }}"
      hx-trigger="click[ctrlKey], click from:find button"
      hx-swap="multi:#n{{ item.id }},#t{{ item.id }}">
      <a href="{{ item.url }}"
        target="_blank"
        onclick="linkHandler(event)"
        title="Product page">
        &#128279;
      </a>
      <a href="{{ item.url_edit }}"
        target="_blank"
        onclick="linkHandler(event)"
        title="Product admin">
        &#9999;
      </a>
      <h4 title="{{ item.id }} {{ item.price }} {{ item.name }}"
        onclick="append(event)">
        {{ item.name }}
      </h4>
      <button>&#8364;</button>
    </div>
    <div id="n{{ item.id }}"></div>
  </summary>
  <div id="t{{ item.id }}" class="info"></div>
</details>
