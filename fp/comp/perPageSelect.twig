<form hx-post="/change_per_page"
  hx-trigger="change from:#perPage"
  style="display:flex; align-items: center;">
  <select id="perPage" name="per_page" title="{{ total }}">
    <option {{ isSelected('50', perPage) }} value="50">
      50
    </option>
    <option {{ isSelected('100', perPage) }} value="100">
      100
    </option>
    <option {{ isSelected('200', perPage) }} value="200">
      200
    </option>
    <option {{ isSelected('500', perPage) }} value="500">
      500
    </option>
  </select>
</form>
