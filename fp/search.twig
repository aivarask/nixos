{% extends 'base.twig' %}

{% block content %}
  <form hx-post="/all" hx-swap="multi:{{ items|swap }}" hx-swap-oob="true">
    <input type="text" name="ids" value="{{ items|ids }}" hidden />
    <button type="submit">All</button>
  </form>
  <div class="container">
    {% for item in items %}
      {% include 'search_accordion.twig' with item %}
    {% else %}
      No search results
    {% endfor %}
  </div>
{% endblock %}
