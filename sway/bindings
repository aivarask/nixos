# vim: ft=swayconfig
# Layout:
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+e layout toggle split
# bindsym $mod+s layout stacking
bindsym $mod+t layout tabbed
bindsym $mod+space fullscreen 
bindsym $mod+Shift+space floating toggle 
bindsym $mod+ctrl+space focus mode_toggle 
# bindsym $mod+p focus parent 

set $yt 'https://youtube.com'

bindsym	$mod+Escape reload
bindsym	$mod+Shift+c kill
# bindsym	$mod+p exec chrome --new-window --incognito 
# bindsym	$mod+p exec chrome --incognito $(cat /etc/nixos/sway/p.txt)
# bindsym $mod+ctrl+w exec firefox $(cat /etc/nixos/sway/sway.txt)
# bindsym	 $mod+shift+w exec firefox --private-window $url

bindsym $mod+w exec firefox -new-window
bindsym $mod+c exec chromium --new-window $url
bindsym $mod+ctrl+c exec chromium --incognito --new-window $url



bindsym	 $mod+f1 exec $term -D /etc/nixos/ nvim
