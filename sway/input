# vim: ft=swayconfig

# sway-input
input type:keyboard {
	repeat_delay 250
	repeat_rate 50
	xkb_numlock enabled
	xkb_layout "us,lt"
	xkb_variant "euro"
	# xkb_options "grp:alt_space_toggle"
	xkb_options "grp:menu_toggle"
}

input "Logitech K270" {
	# xkb_variant "us,"
	# xkb_options "grp:menu_toggle"
	# xkb_model "pc105"
}

# swaymsg -t get_inputs --raw | jq '.[] | select(.type=="touchpad")'
input type:touchpad {
		dwt enabled
		tap enabled
		natural_scroll enabled
		middle_emulation enabled 
		drag_lock enabled
}

input type:pointer {
	left_handed disabled
	accel_profile adaptive 
	pointer_accel -0.9
}

