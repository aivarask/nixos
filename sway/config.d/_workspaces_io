output * bg #000000 solid_color
output * allow_tearing yes
output * max_render_time off
# output * adaptive_sync on
# output * scale_filter nearest

set $4k 3840x2160

output DP-1     resolution 3840x2160 position 1920,0 scale 2
output HDMI-A-1 resolution 1920x1080 position 0,0 scale 1
# output HDMI-A-1 resolution 3840x2160 position 0,0 scale 2
# output HDMI-A-1 color_profile srgb
# output HDMI-A-1 disable

# output eDP-1    resolution 3840x2160 position 0,0 scale 2
# output DP-3     resolution 1920x1080 position 1920,0 scale 1

output eDP-1    resolution 3840x2160 position 1920,0 scale 2
output DP-3     resolution 1920x1080 position 0,0 scale 1

bindsym $mod+greater move workspace to output right
bindsym $mod+less move workspace to output left
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
bindsym $mod+Shift+5 move container to workspace number 5

input type:keyboard {
	repeat_delay 250
	repeat_rate 50
	xkb_numlock enabled
	xkb_layout "us,lt"
	xkb_variant "euro"
	xkb_options "grp:alt_space_toggle"
	# xkb_options "grp:menu_toggle"
  # xkb_options "caps:escape"
}
# swaymsg -t get_inputs --raw | jq '.[] | select(.type=="touchpad")'
input type:touchpad {
		dwt enabled
		tap enabled
		natural_scroll enabled
		middle_emulation enabled
		drag_lock enabled
}
input type:pointer {
	left_handed disabled
	accel_profile adaptive
	pointer_accel -0.9
}
input 'Dell_Dell_Wired_Multimedia_Keyboard' {
    accel_profile flat
}

