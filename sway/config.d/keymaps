for_window [app_id="mpv"] floating enable, resize set 40ppt 30ppt, move position 55ppt 5ppt
for_window [app_id="lxappearance"] floating enable, resize set 40ppt 30ppt, opacity $opacity
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable, resize set 40ppt 30ppt, opacity $opacity
for_window [app_id="one.alynx.showmethekey"] floating enable, sticky enable, opacity $opacity
for_window [app_id="org.gnome.(Calculator|tweaks)"] floating enable, opacity $opacity
for_window [app_id=thunar] floating enable, resize set 40ppt 60ppt, opacity $opacity

bindsym --release $mod+Prior exec $term htop 
bindsym --release $mod+n exec swaync-client -t -sw

bindsym --release $mod+c exec chromium-browser --new-window

bindsym --release $mod+shift+d layout toggle stacking splitv
bindsym --release $mod+p sticky toggle
bindsym --release $mod+space fullscreen
bindsym --release $mod+ctrl+space focus mode_toggle
bindsym --release $mod+shift+space floating toggle
bindsym --release $mod+minus exec "pkill -USR1 waybar"

bindgesture pinch:4 exec playerctl play-pause
bindgesture hold:4 exec playerctl play-pause
bindgesture swipe:3:up exec volumectl +1%
bindgesture swipe:3:down exec volumectl -1%

