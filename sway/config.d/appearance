set $white #ffffff
set $bg #282828
set $red #cc241d
set $green #98971a
set $yellow #d79921
set $blue #458588
set $purple #b16286
set $aqua #689d68
set $gray #a89984
set $darkgray #1d2021

#                         border      backgr      text        indicator   child_border
client.focused            $gray       $gray       $darkgray   $green     $darkgray
client.focused_inactive   $darkgray   $darkgray   $white     $green     $darkgray
client.unfocused          $darkgray   $darkgray   $white     $green     $darkgray
client.urgent             $red        $red        $white      $red        $red
client.placeholder        #000000     #0c0c0c     $white     $bg     #0c0c0c

output * bg /etc/nixos/img/dark_grad.png center
font $font 10
seat seat0 xcursor_theme "XCursor-Pro-Light" 24

# swayfx
corner_radius 4
blur enable
blur_passes 2
blur_radius 4
shadows disable
shadow_blur_radius 4
default_dim_inactive 0.25

