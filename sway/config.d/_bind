bindsym	--release $mod+escape reload
bindsym --release ctrl+escape scratchpad show
bindsym --release shift+escape move scratchpad
bindsym --release $mod+grave exec $term
bindsym --release $mod+menu exec $menu
bindsym --release $mod+ctrl+menu exec nwg-drawer
bindsym --release $mod+q kill
bindsym --release $mod+backspace kill

# `         grave
# ~         asciitilde
# |         bar
# PageUp    Prior
# PageDown  Next
floating_minimum_size 100 x 75
floating_maximum_size -1 x -1
tiling_drag $mod
floating_modifier $mod normal
hide_edge_borders --i3 smart
# focus_on_window_activation smart
force_display_urgency_hint 100


for_window [all] title_window_icon yes
for_window [shell="xwayland"] title_format "[XWayland] %title"
for_window [app_id="thunar"] floating enable
for_window [app_id="^org.gnome.{Calculator,SystemMonitor,tweaks}$"] floating enable
# for_window [app_id="org.gnome.tweaks"] floating enable
# for_window [app_id="org.gnome.SystemMonitor"] floating enable
for_window [app_id="nwg-displays"] floating enable
for_window [title="^Picture-in-Picture$" app_id="firefox"] floating enable, sticky enable
for_window [title="scratchpad-term"] move to scratchpad

# no_focus [window_role="pop-up"]
# for_window [instance=notepad] sticky enable
for_window [title="sway_treeview"] floating enable, resize set 30ppt 30ppt, move position 69ppt 69ppt, nofocus
# for_window [app_id="sway_treeview"] nofocus

bindsym $mod+a exec --no-startup-id $term -o font_size=8 sway_treeview
bindsym --release $mod+Prior exec $term htop 
bindsym --release $mod+n exec swaync-client -t -sw
bindsym --release $mod+w exec firefox
bindsym --release $mod+shift+w exec firefox --private-window
bindsym --release $mod+ctrl+w exec chromium-browser --new-window
bindsym --release $mod+c exec chromium-browser --new-window

bindsym --release $mod+d layout toggle stacking splith
bindsym --release $mod+shift+d layout toggle stacking splitv
bindsym --release $mod+p sticky toggle
bindsym --release $mod+tab focus next
bindsym --release $mod+space fullscreen
bindsym --release $mod+ctrl+space focus mode_toggle
bindsym --release $mod+shift+space floating toggle
bindsym --release $mod+minus exec "pkill -USR1 waybar"

bindgesture pinch:4 exec playerctl play-pause
bindgesture hold:4 exec playerctl play-pause
bindgesture swipe:3:up exec volumectl +1%
bindgesture swipe:3:down exec volumectl -1%

