bindsym	$mod+escape reload
bindsym ctrl+escape scratchpad show
bindsym ctrl+shift+escape move scratchpad
bindsym $mod+grave exec $term
bindsym $mod+menu exec $menu
bindsym $mod+ctrl+Menu exec nwg-drawer
bindsym $mod+q kill
bindsym $mod+delete kill
bindsym $mod+backspace kill
bindsym $mod+shift+c kill

# `         grave
# ~         asciitilde
# |         bar
# PageUp    Prior
# PageDown  Next

bindsym $mod+n exec swaync-client -t -sw
bindsym $mod+t exec firefox -new-window --profile=$XDG_CONFIG_HOME/mozilla/firefox/test
bindsym $mod+w exec firefox -new-window --profile=$XDG_CONFIG_HOME/mozilla/firefox/root
bindsym $mod+shift+w exec firefox -new-window --private-window
bindsym $mod+c exec chromium-browser --new-window

# layout
bindsym $mod+u focus parent
bindsym $mod+p focus parent
bindsym $mod+tab focus next
bindsym $mod+s focus child
bindsym $mod+ctrl+space focus mode_toggle
bindsym $mod+space fullscreen
bindsym $mod+shift+space floating toggle
bindsym $mod+d layout toggle stacking splitv splith
bindsym $mod+minus exec "pkill -USR1 waybar"
bindsym $mod+g sticky toggle
bindsym $mod+r mode "resize"
bindsym $mod+m mode "move"


