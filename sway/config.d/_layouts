# floating https://i3wm.org/docs/userguide.html#_floating
gaps inner 4px
gaps outer 0px
smart_gaps on
default_border pixel
default_floating_border pixel
# hide_edge_borders smart_no_gaps

bindsym $mod+u focus parent
bindsym $mod+s focus child
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+d layout toggle all
# bindsym $mod+s layout stacking
# bindsym $mod+t layout tabbed
bindsym $mod+space fullscreen
bindsym $mod+minus exec "pkill -USR1 waybar"
bindsym $mod+shift+space floating toggle
bindsym $mod+ctrl+space focus mode_toggle
bindsym $mod+p focus parent
bindsym $mod+g sticky toggle

# for_window [floating] opacity 0.5
# swaymsg move position center; swaymsg resize set 80ppt 80ppt

floating_minimum_size 100 x 75
floating_maximum_size -1 x -1
floating_modifier $mod inverse
tiling_drag $mod


bindsym  $mod+m mode "move"
mode "move" {
    bindsym Left  exec sway-move-to left
    bindsym Right exec sway-move-to right
    bindsym Down  exec sway-move-to bottom
    bindsym Up    exec sway-move-to top

    bindsym w     exec sway-move-to top-left
    bindsym e     exec sway-move-to mid-top
    bindsym r     exec sway-move-to top-right
    bindsym s     exec sway-move-to mid-left
    bindsym d     exec sway-move-to centre
    bindsym f     exec sway-move-to mid-right
    bindsym x     exec sway-move-to bottom-left
    bindsym c     exec sway-move-to mid-bottom
    bindsym v     exec sway-move-to bottom-right

    bindsym q mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"
set $resize_px 20px
bindsym --whole-window $mod+button4 resize grow height $resize_px
bindsym --whole-window $mod+button5 resize shrink height $resize_px
mode "resize" {
    bindsym --whole-window button4 resize grow height $resize_px
    bindsym --whole-window button5 resize shrink height $resize_px
    bindsym $left resize shrink width $resize_px
    bindsym $down resize grow height $resize_px
    bindsym $up resize shrink height $resize_px
    bindsym $right resize grow width $resize_px
    bindsym Left resize shrink width $resize_px
    bindsym Down resize grow height $resize_px
    bindsym Up resize shrink height $resize_px
    bindsym Right resize grow width $resize_px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

