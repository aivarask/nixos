{
	"custom/music": {
		"format": "{}        ",
		"tooltip": false,
		"on-click": "spotify",
		"on-click-right": "kitty -e ncmpcpp"
	},
	"custom/editor": {
		"format": "{}        ",
		"tooltip": false,
		"on-click": "kitty --directory /etc/nixos -e nvim",
		"on-click-right": "kitty -d /etc/nixos"
	},
	"custom/files": {
		"format": "{}     ",
		"tooltip": false,
		"on-click": "thunar",
		"on-click-right": "kitty -e lf"
	},
	"custom/firefox": {
		"format": "{}       ",
		"tooltip": false,
		"on-click": "firefox",
		"on-click-right": "firefox --new-private-window",
	},
	"custom/nix-tree": {
		"format": "{}   ",
		"tooltip": false,
		"on-click": "kitty -e nix-tree",
	},
	"custom/monitor": {
		"format": "{}     ",
		"tooltip": false,
		"on-click": "gnome-system-monitor",
		"on-click-right": "kitty -e htop"
	},
	"modules-center": [
		"custom/firefox",
		"custom/music",
		"custom/editor",
		"custom/files",
		"custom/nix-tree",
		"custom/monitor",
		"systemd-failed-units"
	],
	"sway/scratchpad": {
		"format": "{icon} {count}",
		"show-empty": false,
		"tooltip": true,
		"tooltip-format": "{app}: {title}"
	},
	"tray": {
		"spacing": 10,
		"icons": {
			"blueman": "bluetooth",
			"TelegramDesktop": "/run/current-system/sw/share/icons/Papirus/16x16/apps/telegram.svg",
			"firefox": "/run/current-system/sw/share/icons/Papirus/16x16/apps/firefox.svg",
		},
	},
	"temperature": {
		"hwmon-path": "/sys/class/hwmon/hwmon1/temp1_input",
		"critical-threshold": 80,
		"format": "{temperatureC}°C {icon}",
	},
	"systemd-failed-units": {
		"hide-on-ok": true,
		"format": "✗ {nr_failed}:{nr_failed_user}",
		"format-ok": "✓",
		"system": true,
		"user": true,
		"on-click": "kitty -e "
	},
}
