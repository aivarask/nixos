// -*- mode: jsonc -*-
{
    "custom/drawer": {
        "on-click": "nwg-menu",
        "on-click-right": "nwg-drawer",
        "format": "{}⚡     ",
        "tooltip": false
    },
    "custom/run_editor": {
        "on-click": "kitty --directory /etc/nixos -e nvim",
        "on-click-right": "kitty -d /etc/nixos",
        "format": "{}        ",
        "tooltip": false
    },
    "custom/run_gnome_tweaks": {
        "on-click": "gnome-tweaks",
        "format": "{}        ",
        "tooltip": false
    },
    "custom/run_calculator": {
        "on-click": "gnome-calculator",
        "format": "{}        ",
        "tooltip": false
    },
    "custom/run_files": {
        "on-click": "thunar",
        "on-click-right": "kitty -e lf",
        "format": "{}     ",
        "tooltip": false
    },
    "custom/run_firefox": {
        "on-click": "firefox",
        "on-click-right": "firefox --new-private-window",
        "format": "{}       ",
        "tooltip": false
    },
    "custom/run_messenger": {
        "on-click": "firefox https://www.messenger.com/e2ee/t/9295318300565974/",
        "on-click-right": "firefox https://www.facebook.com/",
        "format": "{}       ",
        "tooltip": false
    },
    "custom/run_music": {
        "on-click": "spotify",
        "on-click-right": "kitty -e ncmpcpp",
        "format": "{}        ",
        "tooltip": false
    },
    "custom/run_emoji": {
        "format": "{}😎",
        "tooltip": false,
        "on-click": "bemoji"
    },
    "custom/run_tree": {
        "format": "{}🪾",
        "tooltip": false,
        "on-click": "kitty -e nix-tree",
        "on-click-right": "kitty --hold -e swaymsg -t get_tree"
    },
    "custom/brightness": {
        // waybar-custom
        "exec": "brightness_monitor",
        "format": "🔅 {text}",
        "return-type": "json",
        "restart-interval": 2,
        "tooltip": false,
        "on-scroll-up": "ddcutil setvcp 10 + 5",
        "on-scroll-down": "ddcutil setvcp 10 - 5",
        "on-click": "ddcutil setvcp 10 20",
        "on-click-right": "ddcutil setvcp 10 90"
    },
    "custom/wttrbar": {
        "format": "{}° ",
        "return-type": "json",
        "exec": "wttrbar --location Sirvintos",
        "tooltip": true,
        "interval": 3600
    },
    "custom/power": {
        "format": " ⏻ ",
        "tooltip": true,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power.xml",
        "menu-actions": {
            "shutdown": "shutdown"
        }
    },
    "wlr/taskbar": {
        // waybar-wlr-taskbar
        "format": "{icon}",
        "icon-size": 24,
        "spacing": 4,
        "on-click-middle": "close",
        "tooltip-format": "{title}",
        "ignore-list": [],
        "on-click": "activate"
    },
    "cpu": {
        // waybar-cpu
        "format": " {usage}",
        "on-click": "gnome-system-monitor",
        "on-click-right": "kitty -e htop"
    },
    "systemd-failed-units": {
        "hide-on-ok": true,
        "format": "{nr_failed}:{nr_failed_user}",
        "format-ok": "✓",
        "system": true,
        "user": true,
        "on-click": "kitty --hold -e systemctl --user --failed",
        "on-click-right": "kitty --hold -e systemctl --failed"
    },
    "pulseaudio": {
        // waybar-pulseaudio
        "on-click": "pactl set-sink-mute \\@DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "scroll-step": 5,
        "smooth-scrolling-threshold": 0.3,
        "reverse-scrolling": true,
        "format": "{icon}  {volume} {format_source}",
        "format-bluetooth": "{icon}  {volume}  {format_source}",
        "format-bluetooth-muted": "{icon} - {format_source}",
        "format-muted": "- {format_source}",
        "format-source": " {volume}",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                ""
            ]
        }
    },
    "mpris": {
        // waybar-mpris
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "max-length": 50,
        "player-icons": {
            "default": "▶",
            "spotify": "",
            "firefox": "",
            "chromium-browser": "",
            "mpd": "mpd",
            "mpv": "mpv"
        },
        "status-icons": {
            "paused": "⏸"
        },
        "reverse-scroll": true,
        "smooth-scrolling-threshold": 3.0,
        "on-scroll-left": "playerctl position 15+",
        "on-scroll-right": "playerctl position 15-",
        "on-scroll-up": "playerctl volume 0.05-",
        "on-scroll-down": "playerctl volume 0.05+",
        "ignored-players": [
            "chromium-browser"
        ]
    }
}
