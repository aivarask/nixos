// -*- mode: jsonc -*-
{
    "custom/drawer": {
        "format": " {}",
        "on-click": "nwg-drawer",
        "on-click-right": "nwg-menu",
        "tooltip": false,
        "tooltip-format": "nwg-drawer"
    },
    "custom/symbol": {
        "format": "✨ {}",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/symbol.xml",
        "menu-actions": {
            "icon": "nwg-icon-picker",
            "emoji": "bemoji",
            "glyph": "firefox --new-window glyphsearch.com/?copy=unicode"
        }
    },
    "custom/run_tree": {
        "format": "🪾 {}",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/tree.xml",
        "menu-actions": {
            "nix_tree": "kitty -e nix-tree",
            "sway_tree": "kitty --hold -e swaymsg -t get_tree",
            "sway_treeview": "kitty --hold -e /root/.config/sway/sway_treeview"
        }
    },
    "custom/tools": {
        "format": "🛠️ {}",
        "menu": "on-click",
        "tooltip": false,
        "menu-file": "$HOME/.config/waybar/tools.xml",
        "menu-actions": {
            "calculator": "gnome-calculator",
            "settings": "gnome-tweaks",
            "performance": "gnome-system-monitor",
            "displays": "nwg-displays"
        }
    },
    "custom/run_firefox": {
        "format": "{}       ",
        "tooltip": false,
        "on-click": "firefox",
        "menu": "on-click-right",
        "menu-file": "$HOME/.config/waybar/firefox.xml",
        "menu-actions": {
            "r_swaywm": "firefox --new-window reddit.com/r/swaywm",
            "youtube": "firefox --new-window youtube.com",
            "messenger": "firefox --new-window messenger.com/t/kalesnykas.aivaras",
            "facebook": "firefox facebook.com",
            "private": "firefox --private-window"
        }
    },
    "custom/run_editor": {
        "format": "{}        ",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "/root/.config/waybar/edit.xml",
        "menu-actions": {
            "nixos": "kitty --directory /etc/nixos -e nvim",
            "find_files": "kitty --directory /etc/nixos -- nvim -c ':lua require(\"telescope.builtin\").find_files()'",
            "find_files_home": "kitty nvim -c ':lua require(\"telescope.builtin\").find_files()'",
            "test": "kitty --directory '\/etc\/nixos' -e nvim -- -c ':lua require(\"telescope.builtin\").find_files()'",
            // "bc": "kitty --directory '\/etc\/nixos' nvim -c ':lua require(\"telescope.builtin\").find_files()'",
        }
    },
    "custom/run_files": {
        "on-click": "thunar",
        "on-click-right": "kitty -e lf",
        "format": "{}     ",
        "tooltip": false
    },
    "custom/run_music": {
        "on-click": "spotify",
        "on-click-right": "kitty -e ncmpcpp",
        "format": "{}        ",
        "tooltip": false
    },
    "custom/brightness": {
        // waybar-custom
        "exec": "brightness_monitor",
        "format": "🔅 {text}",
        "return-type": "json",
        "restart-interval": 2,
        "tooltip": false,
        "on-scroll-up": "ddcutil setvcp 10 + 5",
        "on-scroll-down": "ddcutil setvcp 10 - 5",
        "on-click": "ddcutil setvcp 10 20",
        "on-click-right": "ddcutil setvcp 10 90"
    },
    "custom/wttrbar": {
        "format": "{}° ",
        "return-type": "json",
        "exec": "wttrbar --location Sirvintos",
        "tooltip": true,
        "interval": 3600
    },
    "custom/power": {
        "format": " ⏻ ",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power.xml",
        "menu-actions": {
            "suspend": "systemctl suspend",
            // "hibernate": "systemctl hibernate",
            "reboot": "systemctl reboot",
            "poweroff": "systemctl poweroff"
        }
    },
    "wlr/taskbar": {
        // waybar-wlr-taskbar
        "format": "{icon}",
        "icon-size": 24,
        "spacing": 4,
        "on-click-middle": "close",
        "tooltip-format": "{title}",
        "ignore-list": [],
        "on-click": "activate"
    },
    "cpu": {
        // waybar-cpu
        "format": " {usage}",
        "on-click": "gnome-system-monitor",
        "on-click-right": "kitty -e htop"
    },
    "systemd-failed-units": {
        "hide-on-ok": true,
        "format": "{nr_failed}:{nr_failed_user}",
        "format-ok": "✓",
        "system": true,
        "user": true,
        "on-click": "kitty --hold -e systemctl --user --failed",
        "on-click-right": "kitty --hold -e systemctl --failed"
    },
    "pulseaudio": {
        // waybar-pulseaudio
        "format": "  {volume} {format_source}",
        "format-muted": " {format_source}",
        "format-source": " {volume}",
        "format-source-muted": " ",
        "on-click": "pactl set-sink-mute \\@DEFAULT_SINK@ toggle",
        "on-click-right": "pactl set-source-mute 64 toggle",
        "on-click-middle": "pavucontrol",
        "scroll-step": 5,
        "smooth-scrolling-threshold": 0.3,
        "reverse-scrolling": true
    },
    "mpris": {
        // waybar-mpris
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "max-length": 50,
        "player-icons": {
            "default": "▶",
            "spotify": "",
            "firefox": "",
            "chromium-browser": "",
            "mpd": "mpd",
            "mpv": "mpv"
        },
        "status-icons": {
            "paused": "⏸"
        },
        "reverse-scroll": true,
        "smooth-scrolling-threshold": 3.0,
        "on-scroll-left": "playerctl position 15+",
        "on-scroll-right": "playerctl position 15-",
        "on-scroll-up": "playerctl volume 0.05-",
        "on-scroll-down": "playerctl volume 0.05+",
        "ignored-players": [
            "chromium-browser"
        ]
    }
}
