// -*- mode: jsonc -*-
[
    {
        "name": "barbot",
        "position": "bottom",
        "spacing": 24,
        "layer": "top",
        "exclusive": false,
        // "ipc": true,
        // "mode": "hide",
        // "start_hidden": true,
        // "modifier": "Mod4",
        "include": [
            "./custom.jsonc"
        ],
        // "modules-left": [
            // "cpu",
            // "systemd-failed-units"
        // ],
        "modules-center": [
            "custom/firefox",
            "custom/messenger",
            "custom/music",
            "custom/editor",
            "custom/files",
            "custom/monitor",
            "custom/gnome-tweaks",
            "custom/gnome-calculator",
            "custom/tree",
        ],
        "modules-right": [
            "pulseaudio",
            "mpris",
        ],
    },
    {
        "name": "bartop",
        "layer": "top",
        "position": "top",
        "height": 24,
        "spacing": 24,
        "ipc": true,
        "reload_style_on_change": true,
        "include": [
            "./custom.jsonc"
        ],
        "modules-left": [
            // "tray",
            "sway/mode",
            "sway/workspaces",
        ],
        "modules-center": [
            "sway/window"
        ],
        "modules-right": [
            // "idle_inhibitor",
            "pulseaudio",
            "custom/brightness",
            "battery",
            "backlight",
            "network",
            "sway/language",
            "custom/wttrbar",
            "clock"
        ],
        "tray": {
            // waybar-tray
            "show-passive-items": true,
            "icon-size": 24,
            "spacing": 8,
            "icons": {
                "telegram": "/root/telegram_logo.jpg"
            }
        },
        "battery": {
            // waybar-battery
            "format": "{icon} {capacity}",
            "format-alt": "{icon} {time}",
            "format-time": "{H}h{M}m",
            "format-full": "{icon} {capacity}",
            "format-charging": "{icon} ⚡{capacity}",
            "format-plugged": "{icon} 🔌{capacity}",
            "format-icons": [
                "",
                "",
                "",
                "",
                ""
            ]
        },
        "sway/workspaces": {
            // waybar-sway-workspaces
            "all-outputs": true,
            "current-only": false,
            "format": "{name} {output} {windows}", // value name icon index output windows
            "reverse-scroll": true,
            "smooth-scrolling-threshold": 3.0,
            "disable-scroll-wraparound": true,
            "enable-bar-scroll": true,
            "disable-auto-back-and-forth": true,
            "warp-on-scroll": false,
            "window-rewrite-default": "{name}",
            "window-rewrite": {
                "class<firefox>": "",
                "class<chromium-browser>": "",
                "class<kitty>": "",
                "class<spotify>": "",
                // "title<.* - (.*) - VSCodium>": "codium $1" // captures part of the window title and formats it into output
            },
            "format-window-separator": " ",
            "expand": true
        },
        "sway/mode": {
            // waybar-sway-mode
            "format": "{}",
            "max-length": 50
        },
        "custom/wttrbar": {
            "format": "{}° ",
            "return-type": "json",
            "exec": "wttrbar --location Sirvintos",
            "tooltip": true,
            "interval": 3600
        },
        "custom/brightness": {
            // waybar-custom https://github.com/Alexays/Waybar/wiki/Module:-Custom
            "exec": "brightness_monitor",
            "format": "🔅 {text}",
            "return-type": "json",
            "restart-interval": 2,
            "tooltip": false,
            "on-scroll-up": "ddcutil setvcp 10 + 5",
            "on-scroll-down": "ddcutil setvcp 10 - 5",
            "on-click": "ddcutil setvcp 10 20",
            "on-click-right": "ddcutil setvcp 10 90"
        },
        "backlight": {
            // waybar-backlight
            "format": "🔅{percent}",
            "smooth-scrolling-threshold": 3.0,
            "reverse-scrolling": true,
            "scroll-step": 5.0,
            "min-brightness": 5.0
        },
        "network": {
            // waybar-network
            // "format-wifi": " {essid} {signaldBm} dBm",
            "format-wifi": "  {signalStrength} {essid}",
            "format-ethernet": "{ipaddr}/{cidr} ",
            "format-alt": "{ipaddr}/{cidr} {ifname}",
            "tooltip-format": "{gwaddr} {ifname}",
            "format-linked": "{ifname} (No IP)",
            "format-disconnected": "No internet",
            "on-click-right": "xdg-open https://192.168.0.1"
        },
        "sway/language": {
            "format": "{flag}"
        },
        "custom/power": {
            "format": " ⏻ ",
            "tooltip": true,
            "menu": "on-click",
            "menu-file": "$HOME/.config/waybar/power.xml",
            "menu-actions": {
                "shutdown": "shutdown"
            }
        },
        "sway/scratchpad": {
            "format": "{icon} {count}",
            "show-empty": false,
            "tooltip": true,
            "tooltip-format": "{app}: {title}"
        },
        "clock": {
            "format": "{:%A %B %d %H:%M %p}",
            "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
        },
        "idle_inhibitor": {
            "format": "{icon} ",
            "format-icons": {
                "activated": "",
                "deactivated": ""
            },
            "timeout": 30.5
        }
    }
]
