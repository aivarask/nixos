// -*- mode: jsonc -*-
// https://github.com/Alexays/Waybar/wiki/Configuration
{
	"layer": "bottom",
	"position": "bottom", // Waybar position (top|bottom|left|right)
	"height": 24, // Waybar height (to be removed for auto height)
	"width": 1280,
	"spacing": 0, // Gaps between modules (4px)
	"reload_style_on_change": true,
	"include": [
		"~/.config/waybar/modules.jsonc",
		"~/.config/waybar/audio.jsonc"
		// "~/.config/waybar/power.jsonc",
	],
	// Choose the order of the modules
	"modules-left": [
		"sway/workspaces",
		"sway/mode"
	],
	"modules-center": [
		"sway/scratchpad"
		// "sway/window"
	],
	"modules-right": [
		"sway/language"
	],
	// Modules configuration
	"sway/workspaces": {
		"disable-scroll": false,
		"all-outputs": true,
		"warp-on-scroll": false,
		"format": "{name}: {icon}",
		"format-icons": {
			"1": "",
			"2": "",
			"3": "",
			"4": "",
			"urgent": "",
			"focused": "",
			"default": ""
		}
	},
	"sway/mode": {
		"format": "<span>{}</span>"
	},
	"sway/scratchpad": {
		"format": "{icon} {count}",
		"show-empty": false,
		"format-icons": [
			"",
			""
		],
		"tooltip": true,
		"tooltip-format": "{app}: {title}"
	}
}
