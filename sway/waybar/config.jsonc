// -*- mode: jsonc -*-
{
    "ipc": true,
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "reload_style_on_change": true,
    "include": [],
    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-center": [
        "custom/firefox",
        "custom/messenger",
        "custom/music",
        "custom/editor",
        "custom/files",
        "custom/nix-tree",
        "custom/monitor",
        "systemd-failed-units",
        "custom/gnome-tweaks",
        "custom/gnome-calculator",
    ],
    "modules-right": [
        "mpris",
        "custom/wttrbar",
        "pulseaudio",
        "custom/brightness",
        "backlight",
        "network",
        "battery",
        "sway/language",
        "clock"
    ],
    "sway/workspaces": {
        // waybar-sway-workspaces
        "format": "{name} {icon} {windows}", // value name icon index output windows
        "reverse-scroll": true,
        "smooth-scrolling-threshold": 3.0,
        "disable-scroll-wraparound": true,
        "enable-bar-scroll": true,
        "disable-auto-back-and-forth": true,
        "warp-on-scroll": false,
        "window-rewrite": {},
        "window-rewrite-default": "{}",
        "format-window-separator": " ",
        "expand": true
    },
    "sway/mode": {
        // waybar-sway-mode
        // "format": "<span>{}</span>"
        "format": " {}",
        "max-length": 50
    },
    "mpris": {
        // waybar-mpris
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "max-length": 50,
        "player-icons": {
            "default": "▶",
            "spotify": "Spotify",
            "mpv": "mpv",
            "mpd": "mpd",
            "firefox": "f"
        }
    },
    "pulseaudio": {
        // waybar-pulseaudio
        "scroll-step": 5,
        "smooth-scrolling-threshold": 0.3,
        "reverse-scrolling": true,
        "format": "{icon}   {volume} {format_source}",
        "format-bluetooth": "{icon}  {volume}  {format_source}",
        "format-bluetooth-muted": "{icon} - {format_source}",
        "format-muted": "- {format_source}",
        "format-source": " {volume}",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": [
                "",
                "",
                ""
            ]
        },
        "on-click": "pactl set-sink-mute \\@DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol"
    },
    "custom/wttrbar": {
        "format": "{}° ",
        "return-type": "json",
        "exec": "wttrbar --location Sirvintos",
        "tooltip": true,
        "interval": 3600
    },
    "custom/brightness": {
        // waybar-custom https://github.com/Alexays/Waybar/wiki/Module:-Custom
        "exec": "brightness_monitor",
        "format": "😎 {text}",
        "return-type": "json",
        "restart-interval": 2,
        "tooltip": false,
        "on-scroll-up": "ddcutil setvcp 10 + 5",
        "on-scroll-down": "ddcutil setvcp 10 - 5",
        "on-click": "ddcutil setvcp 10 20",
        "on-click-right": "ddcutil setvcp 10 90"
    },
    "backlight": {
        // waybar-backlight
        "format": "😎 {percent}",
        "smooth-scrolling-threshold": 3.0,
        "scroll-step": 5.0,
        "min-brightness": 5.0
    },
    "network": {
        // waybar-network
        "format-wifi": " {essid} {signaldBm} dBm",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "format-alt": "{ipaddr}/{cidr} {ifname}",
        "tooltip-format": "{gwaddr} {ifname}",
        "format-linked": "{ifname} (No IP)",
        "format-disconnected": "No internet",
        "on-click-right": "xdg-open https://192.168.1.1"
    },
    "battery": {
        // waybar-battery
        "format": "{icon} {capacity}",
        "format-alt": "{icon} {time}",
        "format-time": "{H}h{M}m",
        "format-full": "{icon} {capacity}",
        "format-charging": "{icon} {capacity}",
        "format-plugged": "{icon} {capacity}",
        "format-icons": [
            "",
            "",
            "",
            "",
            ""
        ]
    },
    "sway/language": {
        "format": "{flag}"
    },
    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%T}",
        "format-alt": "{:%Y-%m-%d}",
        "interval": 1
    },
    "custom/power": {
        "format": " ⏻ ",
        "tooltip": true,
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power.xml",
        "menu-actions": {
            "shutdown": "shutdown"
        }
    },
    "custom/gnome-tweaks": {
        "format": "{}        ",
        "tooltip": false,
        "on-click": "gnome-tweaks",
    },
    "custom/gnome-calculator": {
        "format": "{}        ",
        "tooltip": false,
        "on-click": "gnome-calculator",
    },
    "custom/music": {
        "format": "{}        ",
        "tooltip": false,
        "on-click": "spotify",
        "on-click-right": "kitty -e ncmpcpp"
    },
    "custom/editor": {
        "format": "{}        ",
        "tooltip": false,
        "on-click": "kitty --directory /etc/nixos -e nvim",
        "on-click-right": "kitty -d /etc/nixos"
    },
    "custom/files": {
        "format": "{}     ",
        "tooltip": false,
        "on-click": "thunar",
        "on-click-right": "kitty -e lf"
    },
    "custom/firefox": {
        "format": "{}       ",
        "tooltip": false,
        "on-click": "firefox",
        "on-click-right": "firefox --new-private-window"
    },
    "custom/messenger": {
        "format": "{}       ",
        "tooltip": false,
        "on-click": "firefox https://www.messenger.com/e2ee/t/9295318300565974/",
        "on-click-right": "firefox https://www.facebook.com/"
    },
    "custom/nix-tree": {
        "format": "{}   ",
        "tooltip": false,
        "on-click": "kitty -e nix-tree"
    },
    "custom/monitor": {
        "format": "{}     ",
        "tooltip": false,
        "on-click": "gnome-system-monitor",
        "on-click-right": "kitty -e htop"
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "systemd-failed-units": {
        "hide-on-ok": true,
        "format": "{nr_failed}:{nr_failed_user}",
        "format-ok": "✓",
        "system": true,
        "user": true,
        "on-click": "kitty --hold -e systemctl --user --failed"
    }
}
