// -*- mode: jsonc -*-
[
    {
        "name": "bottom_bar",
        "position": "bottom",
        "height": 34,
        "spacing": 8,
        "layer": "top",
        "exclusive": false,
        // "passthrough": true,
        "start_hidden": false,
        // "ipc": true,
        "include": [
            "./custom.jsonc"
        ],
        "modules-left": [],
        "modules-center": [
            "custom/run_editor",
            "custom/run_files",
            "custom/run_gnome_tweaks",
            "custom/run_calculator",
            "custom/run_files",
            "custom/run_messenger",
            "custom/run_firefox",
            "custom/run_music",
            "custom/run_emoji",
            "custom/run_tree",
        ],
        "modules-right": [
            "pulseaudio",
            "mpris"
        ]
    },
    {
        "name": "top_bar",
        "layer": "top",
        "position": "top",
        "height": 34,
        "spacing": 18,
        "ipc": true,
        "reload_style_on_change": true,
        "include": [
            "./custom.jsonc"
        ],
        "modules-left": [
            // "tray",
            "sway/mode",
            "sway/workspaces",
            "wlr/taskbar"
        ],
        "modules-center": [
            "sway/window"
        ],
        "modules-right": [
            // "idle_inhibitor",
            "pulseaudio",
            // "custom/brightness",
            "battery",
            "backlight",
            "network",
            "sway/language",
            "custom/wttrbar",
            "clock",
            "custom/power"
        ],
        "tray": {
            // waybar-tray
            "show-passive-items": true,
            "icon-size": 24,
            "spacing": 8,
            "icons": {
                "telegram": "/root/telegram_logo.jpg"
            }
        },
        "battery": {
            // waybar-battery
            "format": "{icon} {capacity}",
            "format-alt": "{icon} {time}",
            "format-time": "{H}h{M}m",
            "format-full": "{icon} {capacity}",
            "format-charging": "{icon} ⚡{capacity}",
            "format-plugged": "{icon} 🔌{capacity}",
            "format-icons": [
                "",
                "",
                "",
                "",
                ""
            ]
        },
        "sway/workspaces": {
            // waybar-sway-workspaces
            "all-outputs": true,
            "current-only": false,
            "format": "{name} {output} {windows}", // value name icon index output windows
            "reverse-scroll": true,
            "smooth-scrolling-threshold": 3.0,
            "disable-scroll-wraparound": true,
            "enable-bar-scroll": true,
            "disable-auto-back-and-forth": true,
            "warp-on-scroll": false,
            "window-rewrite-default": "{name}",
            "window-rewrite": {
                "class<firefox>": "",
                "class<chromium-browser>": "",
                "class<kitty>": "",
                "class<spotify>": ""
                // "title<.* - (.*) - VSCodium>": "codium $1" // captures part of the window title and formats it into output
            },
            "format-window-separator": " ",
            "expand": true
        },
        "sway/mode": {
            // waybar-sway-mode
            "format": "{}",
            "max-length": 50
        },
        "backlight": {
            // waybar-backlight
            "format": "🔅{percent}",
            "smooth-scrolling-threshold": 3.0,
            "reverse-scrolling": true,
            "scroll-step": 5.0,
            "min-brightness": 5.0
        },
        "network": {
            // waybar-network
            // "format-wifi": " {essid} {signaldBm} dBm",
            "format-wifi": "  {signalStrength} {essid}",
            "format-ethernet": "{ipaddr}/{cidr} ",
            "format-alt": "{ipaddr}/{cidr} {ifname}",
            "tooltip-format": "{gwaddr} {ifname}",
            "format-linked": "{ifname} (No IP)",
            "format-disconnected": "No internet",
            "on-click-right": "xdg-open https://192.168.0.1"
        },
        "sway/language": {
            "format": "{flag}"
        },
        "sway/scratchpad": {
            "format": "{icon} {count}",
            "show-empty": false,
            "tooltip": true,
            "tooltip-format": "{app}: {title}"
        },
        "clock": {
            "format": "{:%A %B %d %H:%M %p}",
            "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
        },
        "idle_inhibitor": {
            "format": "{icon} ",
            "format-icons": {
                "activated": "",
                "deactivated": ""
            },
            "timeout": 30.5
        }
    }
]
