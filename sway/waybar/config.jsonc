// -*- mode: jsonc -*-
{
	"ipc": true,
	"layer": "top",
	"position": "top",
	"spacing": 0,
	"reload_style_on_change": true,
	"include": [
		"~/.config/waybar/_left.jsonc",
		"~/.config/waybar/_center.jsonc"
	],
	"modules-left": [
		"sway/workspaces",
		"sway/mode"
	],
	"sway/workspaces": {
		// waybar-sway-workspaces
		"format": "{name} {icon} {windows}", // value name icon index output windows
		"format-icons": {
			"1": "",
			"2": "",
			"3": "",
			"default": "",
			"urgent": "",
			"focused": "",
			"persistent": "!",
		},
		// "disable-scroll": false,
		"reverse-scroll": true,
		// "disable-click": false,
		"smooth-scrolling-threshold": 3.0,
		"disable-scroll-wraparound": true,
		"enable-bar-scroll": true,
		// "disable-markup": false,
		// "current-only": false,
		// "persistent-workspaces": {
		// 	"4": [],
		// 	"dell": [
		// 		"eDP-1"
		// 	],
		// },
		// "on-update": "",
		"disable-auto-back-and-forth": true,
		// "alphabetical_sort": false,
		"warp-on-scroll": false,
		"window-rewrite": {
			"class<firefox>": "",
			"title<.* - Mozilla Firefox>": "woo $1"
		},
		"window-rewrite-default": "{name}",
		"format-window-separator": " ",
		"expand": true,
	},
	"sway/mode": {
		// waybar-sway-mode
		"format": "<span>{}</span>"
	},
	"modules-right": [
		"mpris",
		"custom/wttrbar",
		"pulseaudio",
		"custom/brightness",
		"backlight",
		"network",
		"battery",
		"sway/language",
		"clock"
	],
	"mpris": {
		"format": "{player_icon} {dynamic}",
		"format-paused": "{status_icon} {dynamic}",
		"player-icons": {
			"default": "▶",
			"spotify": "Spotify",
			"mpv": "mpv",
			"mpd": "mpd",
			"firefox": "firefox"
		}
	},
	"pulseaudio": {
		"scroll-step": 5,
		"smooth-scrolling-threshold": 0.3,
		"reverse-scrolling": true,
		"format": "{icon}   {volume} {format_source}",
		"format-bluetooth": "{icon}  {volume}  {format_source}",
		"format-bluetooth-muted": "{icon} - {format_source}",
		"format-muted": "- {format_source}",
		"format-source": " {volume}",
		"format-source-muted": "",
		"format-icons": {
			"headphone": "",
			"hands-free": "",
			"headset": "",
			"phone": "",
			"portable": "",
			"car": "",
			"default": [
				"",
				"",
				""
			]
		},
		"on-click": "pactl set-sink-mute \\@DEFAULT_SINK@ toggle",
		"on-click-right": "pavucontrol"
	},
	"custom/wttrbar": {
		"format": "{}° ",
		"return-type": "json",
		"exec": "wttrbar --location Sirvintos",
		"tooltip": true,
		"interval": 3600,
	},
	"custom/brightness": {
		// waybar-custom https://github.com/Alexays/Waybar/wiki/Module:-Custom
		"exec": "brightness_monitor",
		"format": "😎 {text}",
		"return-type": "json",
		"restart-interval": 2,
		"tooltip": false,
		"on-scroll-up": "ddcutil setvcp 10 + 5",
		"on-scroll-down": "ddcutil setvcp 10 - 5",
		"on-click": "ddcutil setvcp 10 20",
		"on-click-right": "ddcutil setvcp 10 90"
	},
	"backlight": {
		"format": "😎 {percent}",
		"smooth-scrolling-threshold": 3.0,
		"scroll-step": 5.0,
		"min-brightness": 5.0,
	},
	"network": {
		// waybar-network
		"format-wifi": " {essid} {signaldBm} dBm",
		"format-ethernet": "{ipaddr}/{cidr} ",
		"format-alt": "{ipaddr}/{cidr} {ifname}",
		"tooltip-format": "{gwaddr} {ifname}",
		"format-linked": "{ifname} (No IP)",
		"format-disconnected": "No internet",
		"on-click-right": "xdg-open https://192.168.1.1"
	},
	"battery": {
// waybar-battery
		"states": {
			"critical": 20,
			"warning": 40,
			"good": 80,
		},
		"format": "{icon}  {capacity}",
		"format-alt": "{icon}  {time}",
		"format-time": "{H}h{M}m",
		"format-full": "{icon}  {capacity}",
		"format-charging": " {capacity}",
		"format-plugged": " {capacity}",
		"format-icons": [
			"",
			"",
			"",
			"",
			""
		]
	},
	"sway/language": {
		"format": "{flag}"
	},
	"clock": {
		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
		"format": "{:%T}",
		"format-alt": "{:%Y-%m-%d}",
		"interval": 1
	},
	"custom/power": {
		"format": " ⏻ ",
		"tooltip": true,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power.xml",
		"menu-actions": {
			"shutdown": "shutdown"
		}
	},
}
