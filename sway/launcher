# vim: ft=swayconfig

set $menu wmenu-run
set $mode_launcher \
[1]/etc/nixos \
[a]rdour8 \
[f]irefox \
[S]potify \
nix-[t]ree \
[s]ystemctl-tui \
[n]cmpcpp \
[M]an-fzf \
[m]anix-fzf \
[p]ulsemixer
bindsym $mod+grave mode "$mode_launcher"
mode "$mode_launcher" {
		bindsym 1 exec $term -D /etc/nixos/ nvim
    bindsym Shift+c exec chrome --incognito
    bindsym Shift+f exec firefox --private-window
    bindsym Shift+m exec $term man-fzf
    bindsym Shift+s exec spotify --enable-features=UseOzonePlatform --ozone-platform=wayland
    bindsym a exec ardour8 -T main -N one
    bindsym c exec chrome
    bindsym f exec firefox
    bindsym m exec $term manix-fzf
    bindsym n exec $term ncmpcpp
    bindsym p exec $term pulsemixer
    bindsym s exec $term systemctl-tui
    bindsym t exec $term nix-tree
		bindsym Escape mode "default"
    bindsym Return mode "default"
}

