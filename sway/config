# ------------------------------------------------------------
# Docs
# ------------------------------------------------------------
# https://github.com/swaywm/sway/wiki
# https://github.com/swaywm/sway/wiki/Useful-add-ons-for-sway
# https://orioninsist.org/blog/sway-wayland-performance-intel-igpu-dual-fhd/

#
set $mod Mod4
set $alt Mod1
set $term kitty
set $menu rofi -show drun
set $left h
set $down j
set $up k
set $right l
set $scrollup button4
set $scrolldown button5
set $scrollright button6
set $scrollleft button7

default_orientation auto
xwayland disable
focus_follows_mouse yes

#
for_window [shell="xwayland"] title_format "[XWayland] %title"
for_window [app_id="thunar"] floating enable
for_window [app_id="org.gnome.Calculator"] floating enable
for_window [app_id="org.gnome.tweaks"] floating enable
for_window [app_id="nwg-displays"] floating enable
for_window [app_id="org.gnome.SystemMonitor"] floating enable
for_window [title="sway_treeview"] floating enable
for_window [title="^Picture-in-Picture$" app_id="firefox"] floating enable, sticky enable
for_window [title="scratchpad-term"] move to scratchpad


include /etc/sway/config.d/*
include $HOME/.config/sway/_*

