# https://github.com/swaywm/sway/wiki
# https://github.com/swaywm/sway/wiki/Useful-add-ons-for-sway
# https://i3wm.org/docs/userguide.html
# https://orioninsist.org/blog/sway-wayland-performance-intel-igpu-dual-fhd/
# https://github.com/Crandel/home/blob/master/.config/sway/setup.sway

set $mod Mod4
set $alt Mod1
set $term kitty
set $menu rofi -show drun
set $left h
set $down j
set $up k
set $right l
set $mouseleft button1
set $mousemiddle button2
set $mouseright button3
set $scrollup button4
set $scrolldown button5
set $scrollright button6
set $scrollleft button7

xwayland disable
focus_follows_mouse yes

include /etc/sway/config.d/*
include $HOME/.config/sway/config.d/*

