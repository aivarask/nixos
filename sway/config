# https://github.com/swaywm/sway/wiki
set $mod Mod4
set $left h
set $down j
set $up k
set $right l
set $term foot
workspace_auto_back_and_forth yes

include ./theme
include ./input
include ./output
include ./notify
include ./launcher
# include ./resize
include ./bindings
include ./bindings_sys

bindsym Print exec grim

bindsym $mod+p exec grimshot save active
bindsym $mod+Shift+p exec grimshot save area
bindsym $mod+Mod1+p  exec grimshot save output
bindsym $mod+Ctrl+p  exec grimshot save window

# exec /run/current-system/sw/bin/inactive-windows-transparency.py --opacity 0.95
exec systemctl --user start gammastep
xwayland disable
# exec swayidle -w timeout 300 'swaymsg "output * power off"' resume 'swaymsg "output * power on"'
# timeout 300 'swaylock -f -c 000000' \
# before-sleep 'swaylock -f -c 000000'

bindsym $mod+minus scratchpad show
bindsym $mod+Shift+minus move scratchpad

include /etc/sway/config.d/*
