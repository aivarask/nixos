# ------------------------------------------------------------
# Docs
# ------------------------------------------------------------
# https://github.com/swaywm/sway/wiki
# https://github.com/swaywm/sway/wiki/Useful-add-ons-for-sway
# https://orioninsist.org/blog/sway-wayland-performance-intel-igpu-dual-fhd/

# ------------------------------------------------------------
# Environment
# ------------------------------------------------------------
set $mod Mod4
set $term kitty
set $menu rofi -show drun
set $left h
set $down j
set $up k
set $right l

# ------------------------------------------------------------
# Performance Tweaks
# ------------------------------------------------------------
xwayland disable
for_window [app_id="thunar"] floating enable
for_window [floating] opacity 0.7
default_border pixel
default_floating_border pixel
focus_follows_mouse yes
output * allow_tearing yes
output * max_render_time off

# output * render_direct_scanout on
output * adaptive_sync on
# output * max_render_time 6
# damage tracking incremental

# ------------------------------------------------------------
# Monitors swaymsg -t get_outputs
# ------------------------------------------------------------
# output * bg #000000 solid_color
output DP-1     resolution 3840x2160 position 0,0 scale 2.5
output HDMI-A-1 resolution 1920x1080 position 1536,0 scale 1
# output HDMI-A-1 disable

output eDP-1    resolution 3840x2160 position 0,0 scale 2
output DP-3     resolution 1920x1080 position 1920,0 scale 1
# output * scale_filter nearest

workspace 5 output DP-3
bindsym $mod+5 workspace number 5
bindsym $mod+Shift+5 move container to workspace number 5

# ------------------------------------------------------------
# Inputs sway-input
# ------------------------------------------------------------
input type:keyboard {
	repeat_delay 250
	repeat_rate 50
	xkb_numlock enabled
	xkb_layout "us,lt"
	xkb_variant "euro"
	xkb_options "grp:alt_space_toggle"
	# xkb_options "grp:menu_toggle"
  # xkb_options "caps:escape"
}
# swaymsg -t get_inputs --raw | jq '.[] | select(.type=="touchpad")'
input type:touchpad {
		dwt enabled
		tap enabled
		natural_scroll enabled
		middle_emulation enabled
		drag_lock enabled
}
input type:pointer {
	left_handed disabled
	accel_profile adaptive
	pointer_accel -0.9
}

# ------------------------------------------------------------
# Autostart
# ------------------------------------------------------------
exec_always gammastep
exec_always mako
exec_always kanshi
exec_always wl-paste --type text --watch cliphist store
exec_always wl-paste --type image --watch cliphist store

# ------------------------------------------------------------
# Idle / Lock
# ------------------------------------------------------------
for_window [app_id="firefox"] inhibit_idle fullscreen
exec_always swayidle -w \
    timeout 1200 'systemctl suspend'

# ------------------------------------------------------------
# Scratchpads
# ------------------------------------------------------------
for_window [title="scratchpad-term"] move to scratchpad
bindsym $mod+minus scratchpad show
bindsym $mod+Shift+minus move scratchpad

# ------------------------------------------------------------
# Bindings
# ------------------------------------------------------------
bar {
# sway-bar
	swaybar_command waybar
}
floating_modifier $mod normal
bindsym	$mod+Escape reload
bindsym ctrl+shift+w exec $term
bindsym $mod+shift+n exec swaync-client -t -sw
bindsym $mod+f11 reload
bindsym	$mod+f12 exit
bindsym $mod+shift+q kill
bindsym $mod+grave exec $term
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
# focus
bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right
# move
bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right
# workspaces
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4
# media
bindsym XF86AudioPlay exec mpc toggle
bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked $mod+z exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked $mod+x exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
# screenshot
bindsym Print exec grim
bindsym $mod+p exec grimshot save active
bindsym $mod+Shift+p exec grimshot save area
bindsym $mod+Mod1+p  exec grimshot save output
bindsym $mod+Ctrl+p  exec grimshot save window
# bindsym $mod+b splith
# bindsym $mod+v splitv
# bindsym $mod+e layout toggle split
# bindsym $mod+s layout stacking
# bindsym $mod+t layout tabbed
bindsym $mod+space fullscreen
bindsym $mod+shift+space floating toggle
bindsym $mod+ctrl+space focus mode_toggle
# bindsym $mod+p focus parent
set $yt 'https://youtube.com'
set $url 'https://example.com'
bindsym $mod+w exec firefox -new-window
bindsym $mod+shift+w exec firefox -new-window --private-window
bindsym $mod+c exec chromium-browser --new-window
bindsym	$mod+shift+c kill
bindsym $mod+ctrl+c exec chromium-browser --incognito --new-window
bindsym	$mod+f1 exec $term --directory=/etc/nixos/ nvim
bindsym $mod+f2 exec $term ncmpcpp
bindsym $mod+f3 exec $term pulsemixer
bindsym $mod+f4 exec $term exec emulate_iso
bindsym $mod+XF86AudioPlay exec spotify
# bindsym $mod+f3 exec ardour8 -T main one

# bindsym $mod+ mode "launch"
mode "launch" {
	bindsym escape mode "default"
}

bindsym $mod+q mode "quit"
mode "quit" {
	bindsym q kill; mode default
	bindsym ctrl+w kill
	bindsym Escape mode "default"
}

bindsym $mod+r mode "resize"
set $resize_px 20px
mode "resize" {
    bindsym $left resize shrink width $resize_px
    bindsym $down resize grow height $resize_px
    bindsym $up resize shrink height $resize_px
    bindsym $right resize grow width $resize_px
    bindsym Left resize shrink width $resize_px
    bindsym Down resize grow height $resize_px
    bindsym Up resize shrink height $resize_px
    bindsym Right resize grow width $resize_px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
# ------------------------------------------------------------
# Appearance
# ------------------------------------------------------------
set $white #ffffff
set $bg #282828
set $red #cc241d
set $green #98971a
set $yellow #d79921
set $blue #458588
set $purple #b16286
set $aqua #689d68
set $gray #a89984
set $darkgray #1d2021
# class                 border|backgr|text|indicator|child_border
client.focused          $green $green $darkgray $purple $darkgray
client.focused_inactive $darkgray $darkgray $yellow $purple $darkgray
client.unfocused        $darkgray $darkgray $yellow $purple $darkgray
client.urgent           $red $red $white $red $red
gaps inner 4px
gaps outer 4px
smart_gaps on
hide_edge_borders smart_no_gaps
font monospace 10
# font pango:monospace 8
seat seat0 xcursor_theme "XCursor-Pro-Light" 24
exec_always {
  gsettings set org.gnome.desktop.interface gtk-theme "Adwaita-dark"
	# gsettings set org.gnome.desktop.interface color-scheme "prefer-dark"
	gsettings set org.gnome.desktop.interface icon-theme "Papirus"
}

# ------------------------------------------------------------
# Other
# ------------------------------------------------------------
include /etc/sway/config.d/*
