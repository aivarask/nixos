# vim:ft=swayconfig

# xwayland disable
focus_follows_mouse yes
# set {{{
set $mod Mod4
set $_ Mod4
set $alt Mod1
set $term kitty
set $menu fuzzel
set $left h
set $down j
set $up k
set $right l
set $mouseleft button1
set $mousemiddle button2
set $mouseright button3
set $scrollup button4
set $scrolldown button5
set $scrollright button6
set $scrollleft button7
set $font pango:FiraCode Nerd Font Mono, Hack Nerd Font
set $maximize border none, move position center, resize set width 100 ppt height 100 ppt
set $opacity 0.8
# }}}
# autostart {{{
# exec_always nwg-dock -r -nows
exec_always swaync
exec kanshi
exec wl-paste -t text --watch clipman store --no-persist
# exec wl-paste -t image --watch cliphist store
# exec ydotoold --socket-path=$YDOTOOL_SOCKET --socket-perm=0660
# }}}
# bar {{{
bar {
	swaybar_command waybar
}
# }}}
# idle {{{
for_window [app_id="firefox"] inhibit_idle fullscreen
exec swayidle -w \
    timeout 6000 'systemctl suspend'
# }}}
# layout {{{
gaps inner 4px
gaps outer 0px
smart_gaps on
default_border pixel
default_floating_border pixel
hide_edge_borders smart_no_gaps
default_orientation auto
workspace_layout stacking
# }}}
# focus {{{
bindsym $_+$left focus left
bindsym $_+$right focus right
bindsym $_+$up focus up
bindsym $_+$down focus down
bindsym $_+left focus left
bindsym $_+right focus right
bindsym $_+up focus up
bindsym $_+down focus down
# }}}
# move {{{
bindsym $_+shift+$left move left
bindsym $_+shift+$right move right
bindsym $_+shift+$up move up
bindsym $_+shift+$down move down
bindsym $_+shift+left move left
bindsym $_+shift+right move right
bindsym $_+shift+up move up
bindsym $_+shift+down move down
# }}}
# move mode {{{
mode "move" {
    bindsym Left  exec sway-move-to left
    bindsym Right exec sway-move-to right
    bindsym Down  exec sway-move-to bottom
    bindsym Up    exec sway-move-to top
    bindsym w     exec sway-move-to top-left
    bindsym e     exec sway-move-to mid-top
    bindsym r     exec sway-move-to top-right
    bindsym s     exec sway-move-to mid-left
    bindsym d     exec sway-move-to centre
    bindsym f     exec sway-move-to mid-right
    bindsym x     exec sway-move-to bottom-left
    bindsym c     exec sway-move-to mid-bottom
    bindsym v     exec sway-move-to bottom-right
    bindsym q mode "default"
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
# }}}
# resize mode {{{
set $res 5ppt
bindsym --whole-window $mod+button4 resize grow height $res
bindsym --whole-window $mod+button5 resize shrink height $res
mode "resize" {
    bindsym --whole-window button4 resize grow height $res
    bindsym --whole-window button5 resize shrink height $res
    bindsym $left resize shrink width $res
    bindsym $down resize grow height $res
    bindsym $up resize shrink height $res
    bindsym $right resize grow width $res
    bindsym Left resize shrink width $res
    bindsym Down resize grow height $res
    bindsym Up resize shrink height $res
    bindsym Right resize grow width $res
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
# }}}
# input {{{
# swaymsg -t get_inputs --raw | jq '.[] | select(.type=="touchpad")'
input type:keyboard {
	repeat_delay 250;
	repeat_rate 50
	xkb_numlock enabled
	xkb_layout "us,lt"
	xkb_variant "euro"
	xkb_options "grp:alt_space_toggle"
	# xkb_options "grp:menu_toggle"
	# xkb_options "caps:escape"
}
input type:touchpad {
		dwt enabled
		tap enabled
		natural_scroll enabled
		middle_emulation enabled
		drag_lock enabled
}
input 'Dell_Dell_Wired_Multimedia_Keyboard' {
    accel_profile flat
}
# }}}
# outputs {{{
# output * bg #000000 solid_color
output * bg /etc/nixos/img/dark_grad.png center
output * allow_tearing yes
output * max_render_time off
# output * adaptive_sync on
# output * scale_filter nearest
set $hd 1920x1080
set $uhd 3840x2160
set $sony 'Sony SONY TV  *00 0x01010101'
set $mon 'Dell Inc. DELL P2715Q V48W26BSA82L'
output $sony resolution $hd position 0 0
output $mon resolution $uhd position 1920 0 scale 2
bindsym Pause output $sony power toggle

# seat seat0 xcursor_theme "XCursor-Pro-Light" 24
# set $sens "type:pointer" accel_profile adaptive pointer_accel -0.8
# input $sens map_to_output $mon
# set $sens2 type:pointer accel_profile flat pointer_accel 0.1
# input $sens2 map_to_output $sony

# output $sony color_profile srgb
# output HDMI-A-1 disable

output eDP-1    resolution $uhd position 1920 0 scale 2
output DP-3     resolution $hd position 0 0 scale 1

# }}}
# gruvbox {{{
set $white #ffffff
set $bg #282828
set $red #cc241d
set $green #98971a
set $yellow #d79921
set $blue #458588
set $purple #b16286
set $aqua #689d68
set $gray #a89984
set $darkgray #1d2021
# }}}
# colors {{{
#                         border      backgr      text        indicator   child_border
client.focused            $gray       $gray       $darkgray   $green     $darkgray
client.focused_inactive   $darkgray   $darkgray   $white     $green     $darkgray
client.unfocused          $darkgray   $darkgray   $white     $green     $darkgray
client.urgent             $red        $red        $white      $red        $red
client.placeholder        #000000     #0c0c0c     $white     $bg     #0c0c0c
# }}}
# swayfx {{{
corner_radius 4
blur enable
blur_passes 2
blur_radius 4
shadows disable
shadow_blur_radius 4
default_dim_inactive 0.20
# }}}

# {{{ gestures
bindgesture pinch:4 exec playerctl play-pause
bindgesture hold:4 exec playerctl play-pause
bindgesture swipe:3:up exec volumectl +1%
bindgesture swipe:3:down exec volumectl -1%
# }}}
# XF86 {{{
bindsym Print exec flameshot
bindsym --locked XF86AudioPlay exec mpc toggle
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioNext exec playerctl next
bindsym --locked XF86AudioMute exec pactl set-sink-mute \@DEFAULT_SINK@ toggle
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked $mod+z exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked $mod+x exec wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioMicMute exec pactl set-source-mute \@DEFAULT_SOURCE@ toggle
bindsym --locked XF86MonBrightnessDown exec brightnessctl set 5%-
bindsym --locked XF86MonBrightnessUp exec brightnessctl set 5%+
# }}}
# esc {{{
bindsym	$_+escape exec kitten quick-access-terminal 
bindsym	$_+f1 exec $term
bindsym $_+f2 exec $term
bindsym $_+f3 exec "kitty --directory=/etc/nixos/ vim lua/shared.vim lua/keymaps.vim & kitty --directory=/etc/nixos/ nvim lua/shared.vim lua/keymaps.vim & kitty swaymsg layout splith"
bindsym $_+f5 reload
bindsym $_+f9 exec "kitty & kitty & kitty --hold swaymsg layout splith"
bindsym $_+f10 exec kitty --directory=/etc/nixos/ kitten quick-access-terminal 
bindsym	$_+f11 exit
bindsym $_+f12 exec loginctl terminate-user ""
# }}}
# num {{{
bindsym $_+grave workspace next 
bindsym $_+grave+ctrl exec $term 
bindsym $_+1 workspace number 1
bindsym $_+2 workspace number 2
bindsym $_+3 workspace number 3
bindsym $_+4 workspace number 4
bindsym $_+1+shift move container to workspace number 1
bindsym $_+2+shift move container to workspace number 2
bindsym $_+3+shift move container to workspace number 3
bindsym $_+4+shift move container to workspace number 4
bindsym $_+backspace kill
# }}}
# tab {{{
bindsym $_+tab focus next
bindsym $_+q kill
bindsym $_+w exec firefox
bindsym $_+w+shift exec firefox --private-window
bindsym $_+w+ctrl exec chromium-browser --new-window
bindsym	$_+e exec $term --directory=/etc/nixos/ nvim
bindsym $_+r exec $term --directory=/etc/nixos/ vim
for_window [app_id=tree] floating enable, resize set 30ppt 30ppt, move position 69ppt 1ppt, opacity $opacity
bindsym $_+t exec "killall foot; foot -a tree sway_treeview"
# }}}
# caps {{{
bindsym --release $_+d+shift layout toggle stacking splitv
bindsym $_+d layout toggle stacking splith
bindsym $_+return exec $term 
# }}}
# shift {{{
bindsym $_+z+shift exec zen-twilight
bindsym $_+z+ctrl exec zen-twilight --private-window
bindsym --release $mod+c exec chromium-browser --new-window
bindsym $_+c+shift kill
bindsym --release $mod+n exec swaync-client -t -sw
bindsym $_+less move workspace to output left
bindsym $_+greater move workspace to output right
# }}}
# ctrl {{{
bindsym $_+menu exec $menu
bindsym $_+ctrl+menu exec nwg-drawer
# }}}

bindsym --release $mod+Prior exec $term htop 
bindsym --release $mod+p sticky toggle
bindsym --release $mod+space fullscreen
bindsym --release $mod+ctrl+space focus mode_toggle
bindsym --release $mod+shift+space floating toggle
bindsym --release $mod+minus exec "pkill -USR1 waybar"
# bindsym $mod+u focus parent
# bindsym $mod+p focus parent
# bindsym $mod+s focus child
# bindsym $mod+r mode "resize"
# bindsym $mod+m mode "move"
bindsym --release ctrl+escape scratchpad show
bindsym --release shift+escape move scratchpad

floating_minimum_size 100 x 75
floating_maximum_size -1 x -1
tiling_drag $mod
floating_modifier $mod normal
# hide_edge_borders --i3 smart
focus_on_window_activation smart
force_display_urgency_hint 100
# for_window [all] title_window_icon yes
# for_window [class=".*"] opacity $opacity
# for_window [app_id=".*"] opacity $opacity
# bindsym $mod+g [app_id="foot"] exec swaynag -m call0
# bindsym $mod+g [app_id="firefox"] exec swaynag -m call1
# bindsym $key [con_id=__focused__ app_id=app1] <command1>; [con_id=__focused__ app_id=app2] <command2>
for_window [app_id="mpv"] floating enable, resize set 40ppt 30ppt, move position 55ppt 5ppt
for_window [app_id="lxappearance"] floating enable, resize set 40ppt 30ppt, opacity $opacity
for_window [app_id="org.pulseaudio.pavucontrol"] floating enable, resize set 40ppt 30ppt, opacity $opacity
for_window [app_id="one.alynx.showmethekey"] floating enable, sticky enable, opacity $opacity
for_window [app_id="org.gnome.(Calculator|tweaks)"] floating enable, opacity $opacity
for_window [app_id=thunar] floating enable, resize set 40ppt 60ppt, opacity $opacity

include /etc/sway/config.d/*
