{
	"policies": {
		"AppAutoUpdate": false,
		"Homepage": {
			"Locked": true,
			"Additional": [
				"http://example.org/",
				"http://example.edu/"
			],
			"StartPage": "previous-session"
		},
		"Bookmarks": [
			{
				"Title": "Example",
				"URL": "https://example.com",
				"Favicon": "https://example.com/favicon.ico",
				"Placement": "menu",
				"Folder": "policies"
			},
			{
				"Title": "YouTube",
				"URL": "https://www.youtube.com",
				"Placement": "menu",
				"Folder": "policies"
			}
		],
		"3rdparty": {
			"Extensions": {
				"uBlock0@raymondhill.net": {
					"toOverwrite": {
						"filters": [
							"youtube.com###cinematics,#shorts-cinematic-container"
						]
					},
					"adminSettings": {
						"selectedFilterLists": [
							"ublock-quick-fixes",
							"ublock-experimental",
							"ublock-privacy",
							"ublock-badware",
							"ublock-filters",
							"ublock-annoyances-cookies",
							"annoyances-cookies",
							"ublock-annoyances",
							"user-filters"
						]
					}
				}
			}
		},
		"ExtensionSettings": {
			"uBlock0@raymondhill.net": {
				"installation_mode": "force_installed",
				"install_url": "https://addons.mozilla.org/firefox/downloads/latest/ublock-origin/latest.xpi",
				"private_browsing": true,
				"default_area": "navbar"
			}
		},
		"DisableFirefoxAccount": true,
		"DisableProfileImport": false,
		"DisplayBookmarksToolbar": "never",
		"DisplayMenuBar": "default-off",
		"FirefoxHome": {
			"Search": true,
			"TopSites": true,
			"SponsoredTopSites": false,
			"Highlights": false,
			"Pocket": false,
			"Stories": false,
			"SponsoredPocket": false,
			"SponsoredStories": false,
			"Snippets": false,
			"Locked": true
		},
		"OverrideFirstRunPage": "",
		"OverridePostUpdatePage": "",
		"OfferToSaveLoginsDefault": false,
		"PopupBlocking": {
			"Allow": [
				"http://example.org/",
				"http://example.edu/"
			],
			"Default": true,
			"Locked": true
		},
		"PromptForDownloadLocation": true,
		"RequestedLocales": "lt,de,en-US",
		"SanitizeOnShutdown": {
			"Cache": false,
			"Cookies": false,
			"FormData": false,
			"History": false,
			"Sessions": false,
			"SiteSettings": false,
			"Locked": false
		},
		"SearchSuggestEnabled": true,
		"SearchBar": "unified",
		"SearchEngines": {
			"Default": "DuckDuckGo",
			"PreventInstalls": true
		},
		"ShowHomeButton": true,
		"HardwareAcceleration": false,
		"SkipTermsOfUse": true,
		"DisablePocket": true,
		"BlockAboutConfig": false
	}
}
