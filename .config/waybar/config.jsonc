// -*- mode: jsonc -*-
// https://github.com/Alexays/Waybar/wiki/Configuration
{
	"layer": "bottom",
	// "position" "bottom",
	// "height": 24,
	// "width": 1280,
	"spacing": 20,
	"reload_style_on_change": true,
	"include": [
		"~/.config/waybar/modules.jsonc",
		"~/.config/waybar/audio.jsonc"
	],
	"modules-left": [
		"sway/workspaces",
		"sway/mode"
	],
	"modules-center": [
		"sway/scratchpad"
		// "sway/window"
	],
	"modules-right": [
		"backlight",
		"sway/language",
		"clock"
	],
	// Modules configuration
	"sway/workspaces": {
		"disable-scroll": false,
		"all-outputs": true,
		"warp-on-scroll": false,
		"format": "{name}: {icon}",
		"format-icons": {
			"1": "",
			"2": "",
			"3": "",
			"4": "",
			"urgent": "",
			"focused": "",
			"default": ""
		}
	},
	"sway/mode": {
		"format": "<span>{}</span>"
	},
	"sway/scratchpad": {
		"format": "{icon} {count}",
		"show-empty": false,
		"format-icons": [
			"",
			""
		],
		"tooltip": true,
		"tooltip-format": "{app}: {title}"
	}
}
