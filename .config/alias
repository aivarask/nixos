export BW_SESSION='cHLrqQeOTy4Z9JYaFBOjviAXbJSDXQ2uZeqgE55CdvYF+LRzIqbhLnmji2Mg6OevppjpXLIOMdTMvMBGUrwisw=='

alias \\l='lazygit'
alias \\s='systemctl-tui -s all'
alias sd='systemctl-tui'
alias nil='nix-locate'
alias nt='nix-tree'
alias bw_='bitwarden --no-sandbox --session $BW_SESSION'
alias fd='fd --hidden --follow'
alias lg='lazygit'
alias lnav_nvim='lnav $XDG_STATE_HOME/nvim/logs/*.log'
alias nfu='nix flake update'
alias nrs_='nixos-rebuild switch'
alias nrs='nixos-rebuild switch --no-reexec --verbose'
alias nrs_offline='nrs --option substitute false'
alias nr='nrs --option substituters "https://cache.nixos.org https://nix-community.cachix.org"'
alias pw-rec='pw-record --latency=20ms --volume=1.0 --format=f32 --channel-map stereo --rate 44100'
alias st='speedtest'
alias wttr='curl wttr.in' # https://wttr.in/:help https://github.com/chubin/wttr.in
alias wttr_srv='wttrbar --location Sirvintos'
alias yt-dlp='yt-dlp --cookies-from-browser firefox'
# alias vim='vim -S'
alias nvim='nvim -S'

### firefox
alias firefox_aiva='firefox --profile=$XDG_CONFIG_HOME/mozilla/firefox/aiva.profile'
alias firefox_test='firefox --profile=$XDG_CONFIG_HOME/mozilla/firefox/_test.profile'

### build
alias iso_build='nix build $SELF\#nixosConfigurations.iso.config.system.build.isoImage'
### emulate
alias iso_emulate='qemu-system-x86_64 -enable-kvm -m 1G -cdrom $SELF/result/iso/nixos-*.iso'
alias iso_build_emulate='iso_build && iso_emulate'
### write
alias iso_write_sd_a='dd bs=128K if=$SELF/result/iso/$(ls $SELF/result/iso) of=/dev/sda oflag=direct status=progress'
alias iso_write_sd_c='dd bs=128K if=$SELF/result/iso/$(ls $SELF/result/iso) of=/dev/sdc oflag=direct status=progress'
# mount
alias iso_mount='mount -o loop $SELF/result/iso/nixos-*.iso mnt'

### clang
alias clang-format='clang-format --style=file:$XDG_CONFIG_HOME/clangd/format.yaml'
alias ctags='ctags -R --exclude=.git --exclude=node_modules --exclude=vendor --exclude=db --exclude=log --exclude=.config --exclude=httpd --exclude=firefox --exclude=img --exclude=sway .'

alias test_env_var='echo $SELF/modules'
### move copy
alias cp_rsync_avxP='rsync -avxP'
alias mv_rsync_avxP_remove-source-files='rsync -avxP --remove-source-files'
