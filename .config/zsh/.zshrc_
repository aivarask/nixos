#!/usr/bin/env zsh
# shellcheck shell=zsh

source $HOME/.alias

autoload -Uz edit-command-line
zle -N edit-command-line
bindkey '\ev' edit-command-line
autoload -Uz run-help run-help-git run-help-nix run-help-ip run-help-openssl run-help-sudo
(( ${+aliases[run-help]} )) && unalias run-help
alias help=run-help

# https://github.com/marlonrichert/zsh-autocomplete?tab=readme-ov-file#reassign-keys
autoload -Uz chpwd_recent_dirs cdr add-zsh-hook
# add-zsh-hook chpwd chpwd_recent_dirs
bindkey '^I' menu-select
bindkey '^[[Z' menu-select
bindkey -M menuselect '^I' menu-complete # Tab
bindkey -M menuselect '^[[Z' reverse-menu-complete # S-Tab
bindkey -M menuselect  '^[[D' .backward-char  '^[OD' .backward-char
bindkey -M menuselect  '^[[C'  .forward-char  '^[OC'  .forward-char
bindkey -M menuselect '^M' .accept-line

zstyle ':autocomplete:*' append-semicolon no
# zstyle ':completion:*:make:*:targets' call-command true
# zstyle ':completion:*:*:make:*' tag-order 'targets'
# zstyle ':completion:*' rehash true
# zstyle ':completion:*' menu select
# zstyle ':completion:*' verbose yes
# zstyle ':completion:*' use-cache on
# zstyle ':completion:*' cache-path "$XDG_CACHE_HOME/zsh/.zcompcache"

# cat -v	#	showkey
bindkey '^N' menu-complete
bindkey '^P' reverse-menu-complete
bindkey '^ ' forward-word            # C-Space
# bindkey '^[[1;5C' autosuggest-accept # C-Right
bindkey '^[[3;5~' kill-word          # C-Del
bindkey "^[OP" "run-help"            # <F1>
bindkey -s "^[[15~" "exec zsh\n" 		 # <F5>

bindkey -M vicmd Y zsh-system-clipboard-vicmd-vi-yank-eol

source /etc/nixos/.config/zsh/zfunc

cmd_preview () { pistol $BUFFER }
zle -N cmd_preview cmd_preview
bindkey -v '^]' cmd_preview

cmd_xclip ()  { 
	echo $BUFFER | xclip 
}
zle -N cmd_xclip cmd_xclip
bindkey -v '' cmd_xclip

