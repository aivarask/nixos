#!/usr/bin/env zsh
# shellcheck shell=zsh

setopt extended_glob
export ZSH_SYSTEM_CLIPBOARD_METHOD=wlp
export RIPGREP_CONFIG_PATH="$XDG_CONFIG_HOME/ripgreprc"
export NIX_PACKAGE_SEARCH_EXPERIMENTAL=true
export YDIFF_OPTIONS='-w40'

fpath=(/etc/nixos/.config/zsh $fpath)
# autoload -Uz $fpath[1]/**/*(.:t)
autoload -Uz zfunc

typeset -TU PATH path ':'
path+=(${0:a:h}/bin)
# path+=( /etc/nixos/*(N-/) )

typeset -TU CPATH cpath ':'
cpath+=('/run/current-system/sw/include/' '/root/include/')

typeset -TU VST3_PATH vst3path ':'
vst3path+=('/etc/nixos/audio/vst3')

typeset -TU NIX_PROFILES nix_profiles ' '
typeset -TU GTK_PATH gtk_path ':'
typeset -TU XCURSOR_PATH xcursor_path ':'

typeset -TU LUA_PATH luapath ';'
luapath+=('/etc/nixos/lua/?.lua')
luapath+=('/etc/nixos/lua/?/init.lua')
luapath+=('/etc/luajit/share/lua/5.1/?/init.lua')
luapath+=('/etc/luajit/share/lua/5.1/?.lua')
